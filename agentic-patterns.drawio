                <mxPoint x="681.9" y="488.25" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:D-&gt;Op#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0;entryY=0.04;" mermaidBaseValue="" id="m10">
          <mxCell edge="1" parent="1" source="m3" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0;entryY=0.04;" target="m5">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="257.2" y="678.9" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:A-&gt;Op#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=1;entryY=0.04;" mermaidBaseValue="" id="m11">
          <mxCell edge="1" parent="1" source="m4" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=1;entryY=0.04;" target="m5">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="681.9" y="678.9" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="s0" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;INTENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Surface per-request, per-user, and per-feature cost and token consumption to operators in near-real-time.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="846.35" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONTEXT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A team is running an agent product in production that calls one or more paid model providers and a set of paid tools. Spend depends on which feature the user touched, which model was routed to, how long the conversation got, and how many tool calls the agent decided to make. Operators need to know in close to real time where the money is going, not weeks later when the invoice arrives.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="846.35" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;PROBLEM&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Without per-feature, per-route, per-model attribution, an aggregate dashboard only shows that total tokens went up. A single bad routing decision, a chatty new prompt, or a runaway loop in one feature can multiply the bill for that feature ten times while the global average barely twitches. The team is forced to choose between learning about the problem from the monthly billing statement or building ad-hoc spreadsheets every time a number looks off.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="952.35" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FORCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Telemetry schema must capture which feature, which model, which user.&lt;br&gt;&amp;bull; Real-time vs daily aggregation.&lt;br&gt;&amp;bull; Privacy on per-user attribution.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="990.35" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;THEREFORE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Therefore: tag every model and tool call with feature, route, model id, and anonymised user, and stream those tags to a telemetry store with per-dimension dashboards, so that spend is attributable in near-real-time instead of discovered on the monthly bill.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1115.35" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;SOLUTION&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Tag every model and tool call with feature, route, user (anonymised), and model id. Stream to a telemetry store. Build dashboards by feature, by model, by tier, by hour. Set alerts on anomalies. Pair with cost-gating for prevention.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1115.35" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;STRUCTURE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;font face=&quot;monospace&quot;&gt;Model call / Tool call --tagging middleware (feature, route, model id, anonymised user)--&amp;gt; Tag-or-reject gateway --&amp;gt; Telemetry store --&amp;gt; Dashboards (by feature, model, tier, hour) + Anomaly alerter --&amp;gt; Operators&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1240.35" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EXAMPLE SCENARIO&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;An ops team notices the monthly LLM bill has tripled but can&#39;t say which feature drove it — the dashboard only shows total tokens. By the time billing arrives the runaway feature has been live for weeks. They add Cost Observability: every request is tagged with feature, user, and tenant, and per-feature spend rolls up in near-real-time. Within an hour of a regression the team can see which feature now costs ten times what it did yesterday.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1240.35" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONSEQUENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;b&gt;Benefits&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Fast detection of cost regressions.&lt;br&gt;&amp;bull; Inputs for capacity planning and pricing.&lt;br&gt;&lt;br&gt;&lt;b&gt;Liabilities&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Telemetry overhead.&lt;br&gt;&amp;bull; Per-user attribution has privacy implications.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1384.35" width="755" height="225" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;WHAT THIS PATTERN CONSTRAINS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Calls without telemetry tags fall into an &#39;unattributed&#39; bucket; some internal gateways enforce tag-or-reject.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1403.35" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Per-feature cost visibility is needed before billing reveals a problem.&lt;br&gt;&amp;bull; Telemetry can be tagged with feature, route, model id, and anonymised user.&lt;br&gt;&amp;bull; Operators will actually act on dashboards and alerts that surface cost anomalies.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1623.35" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;DO NOT USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Total spend is small enough that aggregate metrics suffice.&lt;br&gt;&amp;bull; Telemetry pipeline cost exceeds the cost it would help you control.&lt;br&gt;&amp;bull; No operator owns cost — the dashboards would go unwatched.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1509.35" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;COMPONENTS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Tagging Middleware — attaches feature, route, model id, and anonymised user to every model and tool call&lt;br&gt;&amp;bull; Telemetry Store — receives the streamed tagged-cost events&lt;br&gt;&amp;bull; Per-Dimension Dashboards — slice spend by feature, model, tier, and hour&lt;br&gt;&amp;bull; Anomaly Alerter — fires when per-feature spend deviates from baseline&lt;br&gt;&amp;bull; Tag-or-Reject Gateway — refuses untagged calls so spend stays attributable&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1748.35" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s13" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Langfuse — captures and aggregates per-feature token and cost telemetry&lt;br&gt;&amp;bull; Helicone — proxy-style cost and usage telemetry for LLM calls&lt;br&gt;&amp;bull; OpenAI usage dashboard — provider-side per-key spend visibility&lt;br&gt;&amp;bull; Anthropic Console usage — provider-side per-key spend visibility&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1634.35" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s14" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FAILURE MODES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Unattributed bucket growth — new call sites skip the tags, and a growing share of spend lands in the unattributed bucket where no feature owns it.&lt;br&gt;&amp;bull; Alert on the wrong grain — anomaly alerts watch total tokens, so a ten-fold rise in one feature stays under the global threshold.&lt;br&gt;&amp;bull; Re-identification through tags — the per-user tag is weakly anonymised, and the cost store becomes a record of what each person did.&lt;br&gt;&amp;bull; Detection without brakes — the dashboard shows a runaway loop clearly, but nothing stops it until an operator reads the alert.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1930.35" width="755" height="206" as="geometry" />
        </mxCell>
        <mxCell id="s15" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EVALUATION METRICS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Attribution coverage — share of model and tool calls that carry the required tags&lt;br&gt;&amp;bull; Time-to-detect cost regression — minutes from spend spike to operator alert&lt;br&gt;&amp;bull; Per-feature cost variance week-over-week — surfaces chatty prompts and bad routing&lt;br&gt;&amp;bull; Unattributed-bucket spend share — fraction of cost the gateway could not assign&lt;br&gt;&amp;bull; Alert precision on cost anomalies — true-positive rate against confirmed regressions&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1778.35" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s16" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;KNOWN USES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;b&gt;Langfuse&lt;/b&gt; &lt;i&gt;available&lt;/i&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Helicone&lt;/b&gt; &lt;i&gt;available&lt;/i&gt;&lt;br&gt;&amp;bull; &lt;b&gt;OpenAI usage dashboard&lt;/b&gt; &lt;i&gt;available&lt;/i&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Anthropic Console usage&lt;/b&gt; &lt;i&gt;available&lt;/i&gt;&lt;br&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://marco-nissen.com/sparrot/&quot;&gt;Sparrot&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Per-tick and per-provider token / cost telemetry is surfaced so cheap-by-default routing can be audited and premium escalations stay accountable.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2150.35" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s17" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;RELATED PATTERNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Cost Gating&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Lineage Tracking&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;alternative-to&lt;/i&gt; &lt;b&gt;Demo-to-Production Cliff&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;alternative-to&lt;/i&gt; &lt;b&gt;Token-Economy Blindness&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Realtime API When Batchable&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Top-Tier Model For Everything (Cost)&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;used-by&lt;/i&gt; &lt;b&gt;Agent Withdrawal Criteria&lt;/b&gt; — The economic threshold is only evaluable if cost per case is measured continuously and compared against a maintained human baseline.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1941.35" width="755" height="206" as="geometry" />
        </mxCell>
        <mxCell id="s18" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;REFERENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;a href=&quot;https://langfuse.com/docs&quot;&gt;Langfuse&lt;/a&gt;&lt;br&gt;&amp;bull; &lt;a href=&quot;https://docs.helicone.ai&quot;&gt;Helicone&lt;/a&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2332.35" width="755" height="92" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
