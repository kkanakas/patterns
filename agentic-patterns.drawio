        <UserObject label="drift" mermaidId="e:Idle-&gt;Idle#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=#E8E8E88D;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=0.5;entryX=0.5;entryY=0.5;" mermaidBaseValue="drift" id="m4">
          <mxCell edge="1" parent="1" source="m2" style="startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=#E8E8E88D;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);curved=0;rounded=1;arcSize=20;exitX=0.256;exitY=1;entryX=1;entryY=1;" target="m2">
            <mxGeometry relative="1" as="geometry">
              <mxPoint y="163.82" as="offset" />
