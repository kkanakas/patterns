        <UserObject label="" mermaidId="e:Biz-&gt;U#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0;exitY=0.4178082191780822;entryX=1;entryY=0.3888888888888889;curved=1;exitX=0;exitY=0.42;entryX=1;entryY=0.39;" mermaidBaseValue="" id="m8">
          <mxCell edge="1" parent="1" source="m1" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0;exitY=0.42;entryX=1;entryY=0.39;" target="m0">
            <mxGeometry relative="1" as="geometry">
              <mxPoint as="offset" />
