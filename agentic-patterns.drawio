        <UserObject label="" mermaidId="e:Q1-&gt;LOG#0" mermaidBaseStyle="curved=1;dashed=1;dashPattern=2 3;fixDash=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.77;exitY=1;entryX=0.48;entryY=0;" mermaidBaseValue="" id="m21">
          <mxCell edge="1" parent="1" source="m1" style="curved=1;dashed=1;dashPattern=2 3;fixDash=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.77;exitY=1;entryX=0.48;entryY=0;" target="m10">
