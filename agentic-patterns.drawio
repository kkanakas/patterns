  <diagram id="spec-driven-loop" name="Spec-Driven Loop">
    <mxGraphModel dx="1600" dy="3031.2" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="3031.2" math="0" shadow="0">
