                <mxPoint x="158.0" y="1334.55" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="yes" mermaidId="e:Quiet-&gt;Other#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.87;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="yes" id="m14">
