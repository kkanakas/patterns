        <UserObject label="reload typed slice" mermaidId="e:Active-&gt;Active#1" mermaidBaseStyle="curved=1;startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=#E8E8E88D;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.28688524590163933;exitY=0;entryX=0.28688524590163933;entryY=1;curved=1;exitX=0.29;exitY=0;entryX=0.29;entryY=1;" mermaidBaseValue="reload typed slice" id="m8">
