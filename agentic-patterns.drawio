            <mxGeometry height="83.7" width="675.8" x="65.0" y="316.2" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Personal data routed to undisclosed destination" mermaidId="n:D" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Personal data routed to undisclosed destination" id="m2">
