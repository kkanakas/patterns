        <UserObject label="" mermaidId="e:Intense-&gt;_note_0#0" mermaidBaseStyle="curved=1;dashed=1;dashed=1;startArrow=none;endArrow=none;fillColor=none;strokeColor=#aaaa33;exitX=0.15;exitY=1;entryX=0.42;entryY=0;" mermaidBaseValue="" id="m10">
          <mxCell edge="1" parent="1" source="m7" style="curved=1;dashed=1;startArrow=none;endArrow=none;fillColor=none;strokeColor=#aaaa33;exitX=0.15;exitY=1;entryX=0.42;entryY=0;fixDash=1;" target="m8">
