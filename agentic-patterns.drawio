        <UserObject label="" mermaidId="e:L-&gt;C#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.19;entryX=1;entryY=0.98;" mermaidBaseValue="" id="m24">
          <mxCell edge="1" parent="1" source="m11" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.19;entryX=1;entryY=0.98;" target="m2">
