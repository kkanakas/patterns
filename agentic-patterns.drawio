        </UserObject>
        <UserObject label="act with scoped token" mermaidId="e:Agent-&gt;API#0" mermaidBaseStyle="endArrow=block;endSize=9;verticalAlign=bottom;spacingBottom=2;edgeStyle=sequenceEdgeStyle;libavoidRouting=0;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="act with scoped token" id="m7">
          <mxCell edge="1" parent="1" source="m2" style="endArrow=block;endSize=9;verticalAlign=bottom;spacingBottom=2;edgeStyle=sequenceEdgeStyle;libavoidRouting=0;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" target="m4">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="1173.12" y="408.32" />
              </Array>
              <mxPoint x="903.57" y="408.32" as="sourcePoint" />
              <mxPoint x="1441.41" y="408.32" as="targetPoint" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="exchange for narrower token" mermaidId="e:Agent-&gt;AuthZ#0" mermaidBaseStyle="endArrow=block;endSize=9;verticalAlign=bottom;spacingBottom=2;edgeStyle=sequenceEdgeStyle;libavoidRouting=0;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="exchange for narrower token" id="m8">
          <mxCell edge="1" parent="1" source="m2" style="endArrow=block;endSize=9;verticalAlign=bottom;spacingBottom=2;edgeStyle=sequenceEdgeStyle;libavoidRouting=0;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" target="m1">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="692.68" y="465.72" />
              </Array>
              <mxPoint x="903.57" y="465.72" as="sourcePoint" />
              <mxPoint x="483.04" y="465.72" as="targetPoint" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="narrower token (sub=user)" mermaidId="e:AuthZ-&gt;Sub#0" mermaidBaseStyle="dashed=1;fixDash=1;dashPattern=3 3;endArrow=block;endSize=9;verticalAlign=bottom;spacingBottom=2;edgeStyle=sequenceEdgeStyle;libavoidRouting=0;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="narrower token (sub=user)" id="m9">
          <mxCell edge="1" parent="1" source="m1" style="dashed=1;fixDash=1;dashPattern=3 3;endArrow=block;endSize=9;verticalAlign=bottom;spacingBottom=2;edgeStyle=sequenceEdgeStyle;libavoidRouting=0;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" target="m3">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="817.47" y="523.12" />
              </Array>
              <mxPoint x="483.04" y="523.12" as="sourcePoint" />
              <mxPoint x="1153.15" y="523.12" as="targetPoint" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="act within reduced scope" mermaidId="e:Sub-&gt;API#0" mermaidBaseStyle="endArrow=block;endSize=9;verticalAlign=bottom;spacingBottom=2;edgeStyle=sequenceEdgeStyle;libavoidRouting=0;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="act within reduced scope" id="m10">
          <mxCell edge="1" parent="1" source="m3" style="endArrow=block;endSize=9;verticalAlign=bottom;spacingBottom=2;edgeStyle=sequenceEdgeStyle;libavoidRouting=0;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" target="m4">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="1297.9" y="580.53" />
              </Array>
              <mxPoint x="1153.15" y="580.53" as="sourcePoint" />
              <mxPoint x="1441.41" y="580.53" as="targetPoint" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="arch-caption" value="&lt;i&gt;The principal delegates a scoped, short-lived token; authority only narrows as it passes from agent to sub-agent, and the originating principal travels in every token.&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#52606d;" vertex="1" parent="1">
          <mxGeometry x="65" y="692.6" width="1470" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;INTENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Have an agent act for a principal using scoped, short-lived, revocable delegated credentials rather than the principal&#39;s own static secrets, so each action stays attributable across the principal-to-agent-to-subagent chain and a compromise is contained.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="767.6" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONTEXT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A team is deploying an agent that performs real actions for a user — reading mailboxes, calling internal services, moving money, editing records — and often delegates parts of the task to sub-agents or tools. Each of those calls hits a system that needs to know who is acting and with what authority. The team has to decide how the agent proves it is allowed to do what it is attempting, on whose behalf, and within what limits.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="767.6" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;PROBLEM&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Sharing the user&#39;s own credentials or a long-lived broad API key with the agent is the path of least resistance and the most dangerous one: the agent inherits everything the user can do, the key cannot be scoped to the task, and when it leaks — into logs, a prompt, or a compromised sub-agent — it cannot be cleanly revoked. It also collapses the principal chain: a downstream service sees only the borrowed credential and cannot tell whether the user, the agent, or a sub-agent three hops away initiated the action. Without a way to express bounded, attributable delegation, every agent action is either over-privileged or unauditable.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="892.6" width="755" height="187" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FORCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; An agent acting for a user needs authority, but inheriting the user&#39;s full credentials over-privileges it.&lt;br&gt;&amp;bull; Static long-lived secrets cannot be scoped to a single task and cannot be revoked cleanly when they leak.&lt;br&gt;&amp;bull; Downstream services need to know the real initiator across a principal-to-agent-to-subagent chain.&lt;br&gt;&amp;bull; Delegation must be narrow enough to contain a compromise yet broad enough to complete the task.&lt;br&gt;&amp;bull; Each sub-agent needs its own narrower slice of authority, not a copy of the parent&#39;s.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="930.6" width="755" height="187" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;THEREFORE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Therefore: exchange the principal&#39;s identity for scoped, short-lived, revocable tokens issued per task — narrowing the scope again at each sub-agent hop — and carry the originating principal in the token, so every downstream action is bounded and traceable to who authorised it.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1093.6" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;SOLUTION&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Use a delegation flow (an on-behalf-of grant, token exchange, or workload-identity federation) in which the agent trades a proof of the user&#39;s consent for an access token scoped to just the task&#39;s needs, with a short lifetime and a claim identifying the delegating principal. The agent never holds the user&#39;s primary credentials. When the agent spawns a sub-agent or calls a tool, it exchanges its token for a further-narrowed one, so authority only shrinks down the chain. Tokens are revocable centrally, and every issued token and the action it authorised are logged, reconstructing the full principal chain (user, agent, sub-agents) for audit and dispute.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1131.6" width="755" height="187" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;STRUCTURE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;font face=&quot;monospace&quot;&gt;User --consent--&amp;gt; authorization server --scoped short-lived token (sub=user)--&amp;gt; agent --act--&amp;gt; resource; agent --exchange--&amp;gt; authorization server --narrower token--&amp;gt; sub-agent --act within reduced scope--&amp;gt; resource. Revocation and audit log sit at the authorization server.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1218.6" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EXAMPLE SCENARIO&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A scheduling agent needs to read one user&#39;s calendar and send invites, nothing more. Instead of taking the user&#39;s account credentials, it exchanges a consent token for an access token scoped to calendar read-write, valid for fifteen minutes, stamped with the user as the delegating principal. When it hands the drafting step to a sub-agent, that sub-agent gets a token scoped to draft-only. If either token leaks, it expires fast, reveals nothing about the user&#39;s password, and can be revoked without touching the user&#39;s account.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1332.6" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONSEQUENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;b&gt;Benefits&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; A leaked token is scoped and short-lived, so a compromise is contained to one task and expires on its own.&lt;br&gt;&amp;bull; Every action is attributable to the originating principal across the full delegation chain.&lt;br&gt;&amp;bull; Authority can only narrow at each sub-agent hop, never widen.&lt;br&gt;&amp;bull; Tokens can be revoked centrally without rotating the user&#39;s own credentials.&lt;br&gt;&lt;br&gt;&lt;b&gt;Liabilities&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Delegation infrastructure (issuer, exchange, revocation) is non-trivial to stand up and operate.&lt;br&gt;&amp;bull; Over-narrow scopes break tasks mid-run; over-broad scopes recreate the problem the pattern solves.&lt;br&gt;&amp;bull; A deep sub-agent chain multiplies token exchanges and the surface where one could be smuggled or replayed.&lt;br&gt;&amp;bull; Standards for agent on-behalf-of flows are still settling, so implementations may diverge.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1362.6" width="755" height="339" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;WHAT THIS PATTERN CONSTRAINS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;The agent must not hold or reuse the principal&#39;s primary credentials; it may act only under a scoped token whose authority is no broader than the task, and each sub-agent hop may only narrow that scope, never widen it.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1514.6" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; The agent performs real actions for a user against systems that enforce access control.&lt;br&gt;&amp;bull; The task needs only a slice of the user&#39;s authority, not all of it.&lt;br&gt;&amp;bull; Sub-agents or tools each need their own narrower authority.&lt;br&gt;&amp;bull; Actions must be attributable to the originating principal for audit or dispute.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1715.6" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;DO NOT USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; The agent operates only on public data with no privileged actions.&lt;br&gt;&amp;bull; It runs purely as its own first-class principal with no user to act for (use a plain workload identity).&lt;br&gt;&amp;bull; No identity provider or token-exchange capability is available in the environment.&lt;br&gt;&amp;bull; The interaction is a single short-lived call where a static scoped key already suffices.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1639.6" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;COMPONENTS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Authorization server — issues and exchanges scoped, short-lived tokens and records the delegating principal&lt;br&gt;&amp;bull; Consent capture — the point at which the user delegates bounded authority to the agent&lt;br&gt;&amp;bull; Token exchanger — narrows scope when the agent delegates to a sub-agent or tool&lt;br&gt;&amp;bull; Revocation service — invalidates a token centrally without touching the user&#39;s own credentials&lt;br&gt;&amp;bull; Principal-chain audit log — reconstructs user, agent, and sub-agent for every authorised action&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1859.6" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s13" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; OAuth 2.0 / OpenID Connect provider — issues on-behalf-of and exchanged tokens&lt;br&gt;&amp;bull; Token-exchange endpoint (RFC 8693) — trades a subject token for a scoped delegated token&lt;br&gt;&amp;bull; Workload-identity federation — gives the agent process a verifiable machine identity&lt;br&gt;&amp;bull; Short-lived token store — caches issued tokens without persisting the user&#39;s primary credentials&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1802.6" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s14" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FAILURE MODES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Scope too narrow — the token lacks a permission a later step needs, and the task fails halfway through the run.&lt;br&gt;&amp;bull; Scope too broad — a convenience scope grants most of what the user can do, and a leaked token carries nearly the same risk as the user&#39;s own key.&lt;br&gt;&amp;bull; Replayed exchange — in a deep sub-agent chain one exchanged token is captured and reused outside the task it was issued for.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2041.6" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s15" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EVALUATION METRICS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Over-scope rate — share of issued tokens granting more authority than the task used&lt;br&gt;&amp;bull; Token lifetime distribution — how short-lived issued tokens actually are in production&lt;br&gt;&amp;bull; Revocation latency — time from a revoke request to the token no longer being accepted&lt;br&gt;&amp;bull; Principal-chain completeness — fraction of actions whose full principal chain is reconstructable&lt;br&gt;&amp;bull; Static-credential leakage — count of times a primary or long-lived credential reached an agent or log&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1946.6" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s16" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;KNOWN USES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://auth0.com/ai/docs&quot;&gt;Auth0 for AI Agents&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Token vault and asynchronous (CIBA) authorization so an agent receives scoped, user-approved access instead of shared credentials.&lt;br&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://learn.microsoft.com/en-us/entra/agent-id/&quot;&gt;Microsoft Entra Agent ID&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Distinct, governed identities for agents within the enterprise directory.&lt;br&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://datatracker.ietf.org/doc/html/rfc8693&quot;&gt;OAuth 2.0 Token Exchange (RFC 8693)&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Standard mechanism for trading a subject token for a scoped delegated access token without exposing the principal&#39;s primary credential.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2223.6" width="755" height="187" as="geometry" />
        </mxCell>
        <mxCell id="s17" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;RELATED PATTERNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Policy-Gated Agent Action (KRITIS)&lt;/b&gt; — The policy gate checks the scoped token&#39;s authority against rules before the action proceeds.&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Secrets Handling&lt;/b&gt; — Scoped short-lived tokens are the mechanism that keeps the principal&#39;s primary secrets out of the agent.&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Agent Credential Vault&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Deontic Token Delegation&lt;/b&gt; — Pairs duty delegation with the permission and credential delegation this pattern carries.&lt;br&gt;&amp;bull; &lt;i&gt;alternative-to&lt;/i&gt; &lt;b&gt;Static Role for a Dynamic Agent&lt;/b&gt; — Runtime, scoped, short-lived, revocable per-action credentials are the positive model against static-role standing privilege.&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Tenant-Scoped Tool Binding&lt;/b&gt; — Delegated authorization scopes what the agent may do; tenant binding scopes whose data it sees.&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Ephemeral Agent Identity&lt;/b&gt; — Delegation scopes the authority an agent exercises on behalf of a principal; ephemeral identity scopes the agent&#39;s own self that carries that authority, and gives it a task-bounded lifecycle.&lt;br&gt;&amp;bull; &lt;i&gt;alternative-to&lt;/i&gt; &lt;b&gt;Identity Impersonation&lt;/b&gt; — Scoped on-behalf-of delegation under the agent&#39;s own identity is the positive model this impersonation anti-pattern fails to use.&lt;br&gt;&amp;bull; &lt;i&gt;alternative-to&lt;/i&gt; &lt;b&gt;Blanket-Authorization Accountability Rupture&lt;/b&gt; — Scoped, short-lived, revocable delegated credentials are the corrective that keeps each action attributable; blanket authorization is the failure of one broad standing grant that dissolves attribution.&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Verifiable Purchase Mandate&lt;/b&gt; — Delegated authorization scopes the agent&#39;s credentials; the purchase mandate is the per-transaction, network-verifiable evidence layered on top for commerce.&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Signed Agent Card&lt;/b&gt; — Verifying the card precedes safe delegation; delegated authorization then scopes what credentials the now-trusted agent receives.&lt;br&gt;&amp;bull; &lt;i&gt;generalises&lt;/i&gt; &lt;b&gt;Attenuating Delegation Chain&lt;/b&gt; — That pattern gives an agent a scoped, short-lived, revocable credential from an issuer and states that scope should only narrow downstream; this one makes the narrowing a verifiable relation between parent and child links, checkable at the enforcement point without the issuer, and extends it to facets an access scope has no vocabulary for such as remaining depth and spend.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2128.6" width="755" height="605" as="geometry" />
        </mxCell>
        <mxCell id="s18" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;REFERENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;a href=&quot;https://datatracker.ietf.org/doc/html/draft-oauth-ai-agents-on-behalf-of-user-00&quot;&gt;OAuth 2.0 Extension: On-Behalf-Of User Authorization for AI Agents (IETF draft)&lt;/a&gt; — 2026&lt;br&gt;&amp;bull; &lt;a href=&quot;https://datatracker.ietf.org/doc/html/rfc8693&quot;&gt;OAuth 2.0 Token Exchange (RFC 8693)&lt;/a&gt; — 2020&lt;br&gt;&amp;bull; &lt;a href=&quot;https://openid.net/wp-content/uploads/2025/10/Identity-Management-for-Agentic-AI.pdf&quot;&gt;Identity Management for Agentic AI (OpenID Foundation)&lt;/a&gt; — 2025&lt;br&gt;&amp;bull; &lt;a href=&quot;https://zenn.dev/nomhiro/articles/authorized-ai-agents&quot;&gt;認証された委任と認可されたAIエージェント&lt;/a&gt; — 2025&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2424.6" width="755" height="168" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="delegation-not-impersonation" name="Identity Impersonation">
