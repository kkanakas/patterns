        <UserObject label="skip recorded effects, resume" mermaidId="e:Replaying-&gt;Running#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=#E8E8E88D;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.91;exitY=0;entryX=0.5;entryY=1;" mermaidBaseValue="skip recorded effects, resume" id="m12">
