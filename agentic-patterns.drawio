        </UserObject>
        <UserObject label="screenshot (+ optional UI annotations)" mermaidId="e:Phone-&gt;Agent#0" mermaidBaseStyle="endArrow=block;endSize=9;verticalAlign=bottom;spacingBottom=2;edgeStyle=sequenceEdgeStyle;libavoidRouting=0;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="screenshot (+ optional UI annotations)" id="m2">
          <mxCell edge="1" parent="1" source="m0" style="endArrow=block;endSize=9;verticalAlign=bottom;spacingBottom=2;edgeStyle=sequenceEdgeStyle;libavoidRouting=0;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" target="m1">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="505.2" y="327.05" />
              </Array>
              <mxPoint x="181.25" y="327.05" as="sourcePoint" />
              <mxPoint x="829.15" y="327.05" as="targetPoint" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:Agent-&gt;Agent#0" mermaidBaseStyle="edgeStyle=sequenceEdgeStyle;libavoidRouting=0;curved=1;endArrow=block;endSize=9;verticalAlign=bottom;align=center;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="" id="m3">
          <mxCell edge="1" parent="1" source="m1" style="edgeStyle=sequenceEdgeStyle;libavoidRouting=0;curved=1;endArrow=block;endSize=9;verticalAlign=bottom;align=center;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" target="m1">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="883.4" y="398.35" />
                <mxPoint x="889.6" y="416.95" />
                <mxPoint x="883.4" y="435.55" />
              </Array>
              <mxPoint x="829.15" y="398.35" as="sourcePoint" />
              <mxPoint x="829.15" y="435.55" as="targetPoint" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="m4" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;fontColor=light-dark(#333333,#cccccc);" value="reason about target element" vertex="1">
          <mxGeometry height="27.9" width="310.0" x="674.15" y="358.05" as="geometry" />
        </mxCell>
        <UserObject label="tap(x,y) / long_press / swipe / type / back / home" mermaidId="e:Agent-&gt;Phone#0" mermaidBaseStyle="endArrow=block;endSize=9;verticalAlign=bottom;spacingBottom=2;edgeStyle=sequenceEdgeStyle;libavoidRouting=0;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="tap(x,y) / long_press / swipe / type / back / home" id="m5">
          <mxCell edge="1" parent="1" source="m1" style="endArrow=block;endSize=9;verticalAlign=bottom;spacingBottom=2;edgeStyle=sequenceEdgeStyle;libavoidRouting=0;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" target="m0">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="505.2" y="516.15" />
              </Array>
              <mxPoint x="829.15" y="516.15" as="sourcePoint" />
              <mxPoint x="181.25" y="516.15" as="targetPoint" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="next screenshot" mermaidId="e:Phone-&gt;Agent#1" mermaidBaseStyle="dashed=1;fixDash=1;dashPattern=3 3;endArrow=block;endSize=9;verticalAlign=bottom;spacingBottom=2;edgeStyle=sequenceEdgeStyle;libavoidRouting=0;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="next screenshot" id="m6">
          <mxCell edge="1" parent="1" source="m0" style="dashed=1;fixDash=1;dashPattern=3 3;endArrow=block;endSize=9;verticalAlign=bottom;spacingBottom=2;edgeStyle=sequenceEdgeStyle;libavoidRouting=0;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" target="m1">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="505.2" y="587.45" />
              </Array>
              <mxPoint x="181.25" y="587.45" as="sourcePoint" />
              <mxPoint x="829.15" y="587.45" as="targetPoint" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="Action vocabulary specialised per Android / iOS" mermaidId="n:note0" mermaidBaseStyle="html=1;fillColor=light-dark(#fff5ad,#2a2a2a);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Action vocabulary specialised per Android / iOS" id="m7">
          <mxCell parent="1" style="html=1;fillColor=light-dark(#fff5ad,#2a2a2a);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="57.35" width="725.4" x="142.5" y="602.95" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="s0" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;INTENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Drive a smartphone end-to-end through a small, touch-native action vocabulary (tap, long-press, swipe, type, back, home) over screenshots, as a distinct interaction surface from desktop Computer Use and from web Browser Agents.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="837.05" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONTEXT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A team needs an agent to operate a mobile app on a real or emulated phone: a ride-hailing app, a food delivery app, a banking app, a Chinese super-app. The app exposes no public API and no clean web frontend that mirrors its functionality, so the only surface available is the touch user interface itself.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="837.05" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;PROBLEM&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Mouse-and-keyboard action sets borrowed from desktop Computer Use do not match how phones are operated, and the DOM / accessibility tree abstractions used by browser agents do not exist for native mobile apps. Driving the phone purely as pixel coordinates without a touch-shaped action vocabulary leaves the agent reasoning one click at a time over coordinates, which is too low-level to plan with and brittle to screen size, theme, and locale changes.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="962.05" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FORCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Mobile actions are touch-native, gesture-based, and screen-coordinate dependent.&lt;br&gt;&amp;bull; Per-app APIs do not exist; only the UI is available.&lt;br&gt;&amp;bull; Screen size is small; what fits on one screen does not generalise.&lt;br&gt;&amp;bull; Visual state is the source of truth, but text is what the model reasons in.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="981.05" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;THEREFORE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Therefore: define a touch-native action vocabulary (tap, long-press, swipe, type, back, home) over screenshots, so that the agent drives apps that expose no API while keeping the loop platform-agnostic above the gesture layer.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1125.05" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;SOLUTION&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Define a touch-native action vocabulary (tap(x,y), long_press(x,y), swipe(dir), type(text), back, home). The agent receives a screenshot (optionally with extracted UI element annotations), reasons in text about which element to act on, emits an action call, and observes the next screenshot. Specialise the action vocabulary per platform (Android vs iOS) but keep the agent loop platform-agnostic.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1125.05" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;STRUCTURE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;font face=&quot;monospace&quot;&gt;Screenshot + history -&amp;gt; agent -&amp;gt; action_call(tap|swipe|type|...) -&amp;gt; device -&amp;gt; next screenshot -&amp;gt; ...&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1250.05" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EXAMPLE SCENARIO&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A team tries to reuse their desktop computer-use agent on Android by injecting mouse-and-keyboard actions through ADB. The agent fights the touch interface, mistakes long-press menus for hover tooltips, and cannot find the back button. They rebuild as a mobile-ui-agent: a touch-native action vocabulary (tap, long-press, swipe, type, back, home), screenshots with extracted UI element annotations, and the model reasons about which element to act on instead of which pixel. The agent completes mobile flows like food ordering and ride-booking end to end.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1269.05" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONSEQUENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;b&gt;Benefits&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Works against any app whose UI is visible, including third-party Chinese super-apps with no APIs.&lt;br&gt;&amp;bull; Single agent loop generalises across apps once the vocabulary is fixed.&lt;br&gt;&amp;bull; Vision + small action set is a tractable model footprint.&lt;br&gt;&lt;br&gt;&lt;b&gt;Liabilities&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Coordinate-based taps are brittle to screen size, theme, locale changes.&lt;br&gt;&amp;bull; Pure-vision grounding mistakes are common; element-annotation pipelines add complexity.&lt;br&gt;&amp;bull; Sensitive actions (payments, deletions) are easy to mis-fire.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1356.05" width="755" height="263" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;WHAT THIS PATTERN CONSTRAINS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;The agent may only emit actions in the registered touch-action vocabulary; arbitrary system or shell access is forbidden by construction.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1451.05" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; The target environment is a smartphone where touch is the only useful input.&lt;br&gt;&amp;bull; Desktop Computer Use or Browser Agent action sets are the wrong shape for the task.&lt;br&gt;&amp;bull; A small touch-native vocabulary (tap, swipe, type, back, home) covers the workflow.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1633.05" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;DO NOT USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; The task can be done via a web Browser Agent against the same service.&lt;br&gt;&amp;bull; Desktop Computer Use is the natural fit and a phone is incidental.&lt;br&gt;&amp;bull; Pixel-level control without an action vocabulary is acceptable for the use case.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1557.05" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;COMPONENTS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Mobile Agent — reasons over screenshots and emits touch-native actions&lt;br&gt;&amp;bull; Touch Action Vocabulary — small typed set (tap, long_press, swipe, type, back, home)&lt;br&gt;&amp;bull; Mobile UI Driver — executes actions via ADB on Android or accessibility APIs on iOS&lt;br&gt;&amp;bull; Screenshot Pipeline — captures frames optionally annotated with extracted UI element bounds&lt;br&gt;&amp;bull; Platform Adapter — keeps the agent loop platform-agnostic while specialising the action set per OS&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1758.05" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s13" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Android ADB or appium driver — executes taps, swipes, and key events on real or emulated devices&lt;br&gt;&amp;bull; iOS accessibility automation — drives the touch action set on iOS targets&lt;br&gt;&amp;bull; UI element extractor — produces annotated element bounds to augment the raw screenshot&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1682.05" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s14" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FAILURE MODES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Coordinate miss — a tap computed on one screen size or theme lands on the wrong element on another device.&lt;br&gt;&amp;bull; Misread screen — pure-vision grounding takes a decorative icon for a button, and the agent taps nothing useful or the wrong control.&lt;br&gt;&amp;bull; Mis-fired sensitive action — a swipe or tap confirms a payment or deletion that the agent meant only to open.&lt;br&gt;&amp;bull; Platform leak — an Android-only action like back is used on iOS, and the loop stalls on a screen it cannot leave.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1921.05" width="755" height="206" as="geometry" />
        </mxCell>
        <mxCell id="s15" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EVALUATION METRICS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Task success on AndroidWorld and similar mobile benchmarks — headline capability&lt;br&gt;&amp;bull; Tap-coordinate accuracy — fraction of taps landing on the intended element&lt;br&gt;&amp;bull; Swipe-direction success rate — share of swipes producing the expected scroll or navigation&lt;br&gt;&amp;bull; Cross-platform parity — delta in task success between Android and iOS runs&lt;br&gt;&amp;bull; Vision tokens per step — prompt-side cost of feeding screenshots back each loop&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1807.05" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s16" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;KNOWN USES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://github.com/TencentQQGYLab/AppAgent&quot;&gt;AppAgent (Tencent)&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Touch-action vocabulary plus exploration-phase documentation per app.&lt;br&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://github.com/X-PLUG/MobileAgent&quot;&gt;Mobile-Agent (Alibaba)&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Vision-first smartphone agent.&lt;br&gt;&amp;bull; &lt;b&gt;Mobile-Agent-v2 (Alibaba)&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Multi-agent mobile assistant: planning, decision, reflection.&lt;br&gt;&amp;bull; &lt;b&gt;AutoGLM (Zhipu)&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Phone agent with decision/grounding split.&lt;br&gt;&amp;bull; &lt;b&gt;CogAgent (Tsinghua + Zhipu)&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Vision-language model purpose-built for GUI screens.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2141.05" width="755" height="187" as="geometry" />
        </mxCell>
        <mxCell id="s17" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;RELATED PATTERNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;i&gt;alternative-to&lt;/i&gt; &lt;b&gt;Computer Use&lt;/b&gt; — Sibling pattern for desktop UI.&lt;br&gt;&amp;bull; &lt;i&gt;alternative-to&lt;/i&gt; &lt;b&gt;Browser Agent&lt;/b&gt; — Sibling pattern for web UI.&lt;br&gt;&amp;bull; &lt;i&gt;uses&lt;/i&gt; &lt;b&gt;Structured Output&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;App Exploration Phase&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Dual-System GUI Agent&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;uses&lt;/i&gt; &lt;b&gt;Foveated Perception Escalation&lt;/b&gt; — Small screens with dense controls are the case where a coarse view locates a target that it cannot resolve precisely enough to touch.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1970.05" width="755" height="187" as="geometry" />
        </mxCell>
        <mxCell id="s18" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;REFERENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;a href=&quot;https://arxiv.org/abs/2312.13771&quot;&gt;AppAgent: Multimodal Agents as Smartphone Users&lt;/a&gt; — Zhang et al., 2023&lt;br&gt;&amp;bull; &lt;a href=&quot;https://arxiv.org/abs/2401.16158&quot;&gt;Mobile-Agent: Autonomous Multi-Modal Mobile Device Agent with Visual Perception&lt;/a&gt; — Wang et al., 2024&lt;br&gt;&amp;bull; &lt;a href=&quot;https://arxiv.org/abs/2406.01014&quot;&gt;Mobile-Agent-v2: Mobile Device Operation Assistant with Effective Navigation via Multi-Agent Collaboration&lt;/a&gt; — Wang et al., 2024&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2342.05" width="755" height="168" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="modality-conflict-arbitration" name="Modality-Conflict Arbitration">
    <mxGraphModel dx="1600" dy="4497.8" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="4497.8" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;font-size:24px&quot;&gt;&lt;b&gt;Modality-Conflict Arbitration&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#52606d&quot;&gt;Verification &amp;amp; Reflection &amp;nbsp; | &amp;nbsp; emerging &amp;nbsp; | &amp;nbsp; Also known as: Cross-Modal Arbitration, Cross-Modal Disagreement Detection, Per-Channel Claim Reconciliation&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1540" height="58" as="geometry" />
        </mxCell>
