        <UserObject label="" mermaidId="e:WA-&gt;P#0" mermaidBaseStyle="curved=1;startArrow=block;startSize=7;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.5;entryX=0.42;entryY=0;" mermaidBaseValue="" id="m17">
          <mxCell edge="1" parent="1" source="m1" style="curved=1;startArrow=block;startSize=7;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.5;entryX=0.42;entryY=0;" target="m10">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="619.86" y="196.04" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:VA-&gt;P#0" mermaidBaseStyle="curved=1;startArrow=block;startSize=7;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.5;entryX=0.33;entryY=0;" mermaidBaseValue="" id="m18">
          <mxCell edge="1" parent="1" source="m3" style="curved=1;startArrow=block;startSize=7;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.5;entryX=0.33;entryY=0;" target="m10">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="619.86" y="354.14" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:EA-&gt;P#0" mermaidBaseStyle="curved=1;startArrow=block;startSize=7;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.5;entryX=0;entryY=0.5;" mermaidBaseValue="" id="m19">
          <mxCell edge="1" parent="1" source="m5" style="curved=1;startArrow=block;startSize=7;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="m10">
            <mxGeometry relative="1" as="geometry">
              <Array as="points" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:SA-&gt;P#0" mermaidBaseStyle="curved=1;startArrow=block;startSize=7;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.5;entryX=0.33;entryY=1;" mermaidBaseValue="" id="m20">
          <mxCell edge="1" parent="1" source="m7" style="curved=1;startArrow=block;startSize=7;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.5;entryX=0.33;entryY=1;" target="m10">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="619.86" y="670.34" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:JA-&gt;P#0" mermaidBaseStyle="curved=1;startArrow=block;startSize=7;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.5;entryX=0.42;entryY=1;" mermaidBaseValue="" id="m21">
          <mxCell edge="1" parent="1" source="m9" style="curved=1;startArrow=block;startSize=7;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.5;entryX=0.42;entryY=1;" target="m10">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="619.86" y="828.43" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:P-&gt;CORE#0" mermaidBaseStyle="curved=1;startArrow=block;startSize=7;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.5;entryX=0;entryY=0.5;" mermaidBaseValue="" id="m22">
          <mxCell edge="1" parent="1" source="m10" style="curved=1;startArrow=block;startSize=7;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="m11">
            <mxGeometry relative="1" as="geometry">
              <Array as="points" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="arch-caption" value="&lt;i&gt;Each delivery channel sits behind its own adapter; all adapters speak the same normalized ports to one channel-agnostic agent core.&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#52606d;" vertex="1" parent="1">
          <mxGeometry x="65" y="875.48" width="1470" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;INTENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Put the agent&#39;s reasoning, tools, and session state behind channel-agnostic ports, and make each delivery surface (web, voice, email, Slack, background jobs) an adapter, so one core serves every channel.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="950.48" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONTEXT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A team that built an agent inside a web chat widget is asked to also offer it over the phone, by email, in Slack, and as a background job that runs with no user present. Each surface has its own transport, turn-taking, latency budget, and message format. The reasoning, tools, and policies are the same in every case, but they were written tangled together with the chat widget&#39;s request-response assumptions.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="950.48" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;PROBLEM&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;When the agent loop is wired straight to one channel&#39;s mechanics, every new surface forces a partial rewrite of logic that has nothing to do with the channel. Voice needs streaming and interruption handling, email is high-latency and asynchronous, Slack threads carry their own identity, and background automation has no live user to clarify with. Copying the agent into each surface duplicates the reasoning and lets the copies drift, so a policy fix made for chat never reaches the phone line.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1075.48" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FORCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Each channel imposes its own transport, turn-taking, modality, and latency, yet the reasoning and policies are identical across them.&lt;br&gt;&amp;bull; Duplicating the agent per channel is fast to start but guarantees the copies drift, so a fix in one surface silently misses the others.&lt;br&gt;&amp;bull; A channel-agnostic core needs a normalized internal message and event shape, but forcing voice, email, and chat through one shape can strip channel-specific affordances such as streaming, attachments, or threading.&lt;br&gt;&amp;bull; Some channels are synchronous and live while others are asynchronous or unattended, so the core cannot assume a user is present to clarify.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1113.48" width="755" height="225" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;THEREFORE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Therefore: put the reasoning, tools, and state behind channel-agnostic input and output ports, and implement each delivery surface as an adapter that translates its transport and modality into those ports and back.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1238.48" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;SOLUTION&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Separate the agent into a core and a set of channel adapters. The core holds the reasoning loop, tool calls, policies, and session state, and it speaks only a normalized internal contract: an inbound event (who, session, content, modality, attachments) and an outbound action (reply, tool effect, hand-off, push). Each delivery surface is an adapter that owns that channel&#39;s specifics: the web adapter handles request-response and rendering, the voice adapter handles streaming audio, barge-in (the caller interrupting mid-sentence), and turn-taking, the email adapter handles asynchronous threads and long latency, the Slack adapter handles thread identity, and a scheduler adapter drives the core with no live user. Session state lives with the core keyed by a channel-independent conversation id, so the same conversation can move across surfaces and the core can run unattended in the background. Adding a channel means writing one adapter, not touching the core; fixing a policy touches the core once and every channel inherits it.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1352.48" width="755" height="263" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;STRUCTURE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;font face=&quot;monospace&quot;&gt;Inbound: channel transport -&amp;gt; channel adapter -&amp;gt; normalized inbound event -&amp;gt; agent core (reason, tools, policy, state). Outbound: agent core -&amp;gt; normalized outbound action -&amp;gt; channel adapter -&amp;gt; channel transport. The core is unaware of which adapter is attached.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1363.48" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EXAMPLE SCENARIO&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A company ships a returns-assistant as a website chat widget, then wants it on the support phone line and in the customer&#39;s email inbox. With a decoupled core, the team writes a voice adapter and an email adapter that translate each channel into the same inbound event the chat widget already produces, and the assistant&#39;s logic, tools, and refund policy are reused untouched. A later policy change — a stricter refund window — is edited once in the core and takes effect on web, phone, and email at the same time.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1629.48" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONSEQUENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;b&gt;Benefits&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; A new delivery surface is one adapter; the reasoning, tools, and policies are reused unchanged.&lt;br&gt;&amp;bull; A policy or behavior fix is made once in the core and every channel inherits it, so surfaces cannot drift apart.&lt;br&gt;&amp;bull; Because the core holds session state under a channel-independent id, one definition runs synchronous chat, multi-session conversations, and unattended background jobs.&lt;br&gt;&lt;br&gt;&lt;b&gt;Liabilities&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; The normalized contract is a design bottleneck: a channel feature it cannot express (streaming tokens, rich attachments, voice interruption) is hard to surface without leaking channel specifics into the core.&lt;br&gt;&amp;bull; An extra translation layer per channel adds latency and a place for bugs, and a thin or wrong contract pushes channel logic back into the core anyway.&lt;br&gt;&amp;bull; Channels differ in identity, auth, and capability, so the adapters carry real complexity even though the core stays simple.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1507.48" width="755" height="377" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;WHAT THIS PATTERN CONSTRAINS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;The agent core must not reference any channel&#39;s transport, message format, or turn-taking directly; it may read and emit only the normalized inbound event and outbound action, and all channel-specific handling stays inside adapters.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1811.48" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; The same agent must run across more than one delivery surface (web, voice, email, chat apps) or across both live and unattended modes.&lt;br&gt;&amp;bull; Channel-specific mechanics (streaming, threading, latency, attachments) keep changing while the reasoning and policies stay the same.&lt;br&gt;&amp;bull; Policy and behavior must stay identical across surfaces, so a single source of truth for logic is required.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1898.48" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;DO NOT USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; The agent serves exactly one channel and there is no foreseeable second surface, so the adapter layer is pure overhead.&lt;br&gt;&amp;bull; A channel&#39;s defining feature cannot survive a normalized contract and must drive the core directly, as in a deeply voice-native experience.&lt;br&gt;&amp;bull; The team cannot maintain the internal contract, so adapters would bypass it and the decoupling would not hold.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1936.48" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;COMPONENTS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Agent core — the channel-agnostic reasoning loop, tools, policies, and session state&lt;br&gt;&amp;bull; Inbound port — the normalized event contract the core consumes (sender, session id, content, modality, attachments)&lt;br&gt;&amp;bull; Outbound port — the normalized action contract the core emits (reply, tool effect, hand-off, push)&lt;br&gt;&amp;bull; Channel adapter — a per-surface translator between a channel&#39;s transport and the ports, one each for web, voice, email, Slack, and scheduler&lt;br&gt;&amp;bull; Session store — holds conversation state under a channel-independent id so a conversation can move across surfaces and run unattended&lt;br&gt;&amp;bull; Capability negotiation — lets an adapter declare what its channel supports (streaming, attachments, interactivity) so the core degrades gracefully&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2080.48" width="755" height="244" as="geometry" />
        </mxCell>
        <mxCell id="s13" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Channel connector SDKs — implement each adapter against a channel&#39;s transport (web, telephony, email, Slack)&lt;br&gt;&amp;bull; Message or activity schema — the normalized internal contract every adapter maps to and from&lt;br&gt;&amp;bull; Session and state store — persists conversation state keyed by a channel-independent id&lt;br&gt;&amp;bull; Background scheduler or event bus — drives the core on unattended channels with no live user&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2118.48" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s14" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FAILURE MODES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Leaky core — channel-specific assumptions (a chat typing indicator, a Slack thread id) seep into the core, and the decoupling erodes until it is channel-coupled again.&lt;br&gt;&amp;bull; Lowest-common-denominator contract — the normalized shape supports only what every channel shares, so rich channels lose streaming, attachments, or voice affordances.&lt;br&gt;&amp;bull; Adapter drift — each adapter re-implements session or auth handling slightly differently, reintroducing the duplication the pattern was meant to remove.&lt;br&gt;&amp;bull; Synchronous assumption — the core asks a clarifying question that an unattended background or email channel cannot answer, and the run stalls.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2338.48" width="755" height="206" as="geometry" />
        </mxCell>
        <mxCell id="s15" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EVALUATION METRICS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Lines of core changed to add a channel — should trend to zero as adapters absorb channel specifics&lt;br&gt;&amp;bull; Behavior parity across channels — whether the same input yields the same policy decision on every surface&lt;br&gt;&amp;bull; Adapter-to-core leak count — how many channel-specific assumptions have crept into the core&lt;br&gt;&amp;bull; Cross-channel session continuity rate — how often a conversation survives moving between surfaces&lt;br&gt;&amp;bull; Per-channel added latency — the cost the adapter and translation layer impose&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2281.48" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s16" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;KNOWN USES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://learn.microsoft.com/en-us/azure/bot-service/bot-service-manage-channels&quot;&gt;Microsoft Bot Framework / Azure Bot Service channels&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Bot logic is built once against the Bot Framework activity schema; the Azure Bot Service connects the same bot to many channels (Teams, Web Chat, telephony, email, Slack) without changing the bot code.&lt;br&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://rasa.com/docs/rasa/connectors/your-own-website/&quot;&gt;Rasa input/output channel connectors&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Rasa runs one assistant behind pluggable input/output connectors (REST, web, Slack, Telegram, Twilio voice, and more); the dialogue logic is written once and a connector adapts each channel.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2558.48" width="755" height="187" as="geometry" />
        </mxCell>
        <mxCell id="s17" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;RELATED PATTERNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Agent Adapter&lt;/b&gt; — Sibling adapter patterns at different boundaries: agent-adapter normalizes heterogeneous tools behind one tool-calling interface; this normalizes heterogeneous delivery channels behind one inbound/outbound contract.&lt;br&gt;&amp;bull; &lt;i&gt;used-by&lt;/i&gt; &lt;b&gt;Managed Agent Runtime&lt;/b&gt; — A managed runtime that fronts chat, voice, email, and webhooks is a hosted realization of this decoupling; the runtime uses channel adapters over a shared agent core.&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Vendor Lock-In&lt;/b&gt; — Same adapter discipline on a different boundary: vendor-lock-in is solved by a model-provider adapter, this by a delivery-channel adapter; applying both keeps the core independent of providers and channels.&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Business + LLM Microservice Split&lt;/b&gt; — Both split an agent system along a boundary so each side evolves on its own: that pattern splits CPU business logic from GPU inference, this splits the channel-agnostic core from per-channel adapters.&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Bidirectional Impulse Channel&lt;/b&gt; — That pattern carries request and push within one channel; this spans many channels, and a bidirectional channel is one adapter the core can drive.&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Event-Driven Agent&lt;/b&gt; — Unattended and background surfaces are event-driven; an event or webhook source is simply another inbound adapter feeding the channel-agnostic core.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2463.48" width="755" height="339" as="geometry" />
        </mxCell>
        <mxCell id="s18" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;REFERENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;a href=&quot;https://en.wikipedia.org/wiki/Hexagonal_architecture_(software&quot;&gt;Hexagonal architecture (software)&lt;/a&gt;)&lt;br&gt;&amp;bull; &lt;a href=&quot;https://learn.microsoft.com/en-us/azure/bot-service/bot-service-manage-channels&quot;&gt;Connect a bot to channels — Azure Bot Service&lt;/a&gt;&lt;br&gt;&amp;bull; &lt;a href=&quot;https://aws.amazon.com/blogs/architecture/architecting-for-agentic-ai-development-on-aws/&quot;&gt;Architecting for agentic AI development on AWS&lt;/a&gt; — 2025&lt;br&gt;&amp;bull; &lt;a href=&quot;https://blog.bytebytego.com/p/what-salesforce-learned-from-20000&quot;&gt;What Salesforce learned from 20,000+ AI agent deployments&lt;/a&gt; — 2026&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2759.48" width="755" height="187" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="chat-chain" name="Chat Chain">
    <mxGraphModel dx="1600" dy="2871.25" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2871.25" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;font-size:24px&quot;&gt;&lt;b&gt;Chat Chain&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#52606d&quot;&gt;Multi-Agent &amp;nbsp; | &amp;nbsp; emerging &amp;nbsp; | &amp;nbsp; Also known as: Phased Multi-Agent Pipeline, Sequential Role-Pair Chats, Communicative Phase Chain&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1540" height="58" as="geometry" />
        </mxCell>
