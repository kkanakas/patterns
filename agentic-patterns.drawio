        <mxCell id="m1" parent="1" style="text;fontSize=16;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;spacingBottom=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);" value="+raw_input_per_tick }" vertex="1">
          <mxGeometry height="37.2" width="623.1" y="235.6" as="geometry" />
        </mxCell>
        <mxCell id="m2" parent="1" style="text;fontSize=16;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;spacingBottom=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);" value="class Working { +top_N_items }" vertex="1">
          <mxGeometry height="37.2" width="623.1" y="272.8" as="geometry" />
        </mxCell>
        <mxCell id="m3" parent="1" style="text;fontSize=16;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;spacingBottom=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);" value="class ShortTerm { +recent_verbatim_1_7d }" vertex="1">
          <mxGeometry height="37.2" width="623.1" y="310.0" as="geometry" />
        </mxCell>
        <mxCell id="m4" parent="1" style="text;fontSize=16;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;spacingBottom=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);" value="class Episodic { +compressed_summaries_5_10x }" vertex="1">
          <mxGeometry height="37.2" width="623.1" y="347.2" as="geometry" />
        </mxCell>
        <mxCell id="m5" parent="1" style="text;fontSize=16;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;spacingBottom=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);" value="class LongTerm { +distilled_rules }" vertex="1">
          <mxGeometry height="37.2" width="623.1" y="384.4" as="geometry" />
        </mxCell>
        <mxCell id="m6" parent="1" style="text;fontSize=16;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;spacingBottom=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);" value="Sensory --&gt; Working : promote" vertex="1">
          <mxGeometry height="37.2" width="623.1" y="421.6" as="geometry" />
        </mxCell>
        <mxCell id="m7" parent="1" style="text;fontSize=16;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;spacingBottom=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);" value="Working --&gt; ShortTerm : promote" vertex="1">
          <mxGeometry height="37.2" width="623.1" y="458.8" as="geometry" />
        </mxCell>
        <mxCell id="m8" parent="1" style="text;fontSize=16;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;spacingBottom=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);" value="ShortTerm --&gt; Episodic : compact" vertex="1">
          <mxGeometry height="37.2" width="623.1" y="496.0" as="geometry" />
        </mxCell>
        <mxCell id="m9" parent="1" style="text;fontSize=16;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;spacingBottom=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);" value="Episodic --&gt; LongTerm : distill" vertex="1">
          <mxGeometry height="37.2" width="623.1" y="533.2" as="geometry" />
        </mxCell>
        <mxCell id="m10" parent="1" style="text;fontSize=16;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;spacingBottom=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);" value="LongTerm ..&gt; Working : rehearsal lifts back" vertex="1">
          <mxGeometry height="37.2" width="623.1" y="570.4" as="geometry" />
        </mxCell>
        <mxCell id="m11" parent="1" style="line;strokeWidth=1;fillColor=none;spacingLeft=3;spacingRight=3;rotatable=0;points=[];strokeColor=inherit;" vertex="1">
          <mxGeometry height="37.2" width="623.1" y="607.6" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;INTENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Stage agent memory across sensory, working, short-term, episodic, and long-term tiers with explicit promotion and decay between them.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="720.8" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONTEXT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A long-running agent accumulates information at very different timescales. Some observations are one-tick-only (&#39;the user just clicked save&#39;); some are one-day patterns (&#39;this user worked on project X this afternoon&#39;); some are one-month rules (&#39;this user prefers concise replies&#39;); some are stable identity facts (&#39;this user&#39;s name is Marco&#39;). A flat single-tier memory store cannot represent these differences in age, decay rate, or relevance horizon.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="720.8" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;PROBLEM&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A flat append-only log collapses signal across timescales: a momentary observation and a stable identity fact look the same and compete for attention. Pure long-term memory, on the other hand, cannot capture momentary salience — a recent flick of attention that needs to live for the next few minutes and then expire. Without an explicit cascade that separates working memory from short-term, episodic, semantic, and long-term tiers, each with its own decay and promotion rules, the agent either drowns in stale recent noise or forgets the very fast signals it needs in order to respond well.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="826.8" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FORCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Promotion criteria from one tier to the next must be defined and audited.&lt;br&gt;&amp;bull; Storage cost grows with tier count.&lt;br&gt;&amp;bull; Reads must consult the right tier; cross-tier conflicts must be resolved.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="883.8" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;THEREFORE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Therefore: stage memory across sensory, working, short-term, episodic, and long-term tiers with explicit promotion, decay, and rehearsal between them, so that every item lives where its access pattern justifies its cost.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1008.8" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;SOLUTION&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Five tiers. Sensory: raw input per tick. Working: top-N items in active focus (Global Workspace Theory, ≤7 items). Short-term: recent verbatim (1-7 days). Episodic: compressed summaries (5-10x). Long-term: distilled rules and insights. Compaction promotes upward on a schedule; decay archives downward; rehearsal lifts archived items back when re-attended.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1008.8" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;STRUCTURE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;font face=&quot;monospace&quot;&gt;Sensory (raw input per tick) --promote--&amp;gt; Working (top-N focus) --promote--&amp;gt; Short-term (recent verbatim) --compact--&amp;gt; Episodic (compressed summaries) --distill--&amp;gt; Long-term (rules, insights); decay archives downward; rehearsal lifts archived items back to Working&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1133.8" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EXAMPLE SCENARIO&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A personal agent that runs continuously needs to track the user&#39;s last sentence (sensory), the current task (working), today&#39;s session (short-term), the last few weeks of episodes (episodic), and stable preferences (long-term). A flat append-only log either grows unboundedly or loses the immediate signal. The team builds a Five-Tier Memory Cascade with explicit promotion (today&#39;s confirmed preference moves to long-term) and decay (yesterday&#39;s sensory buffer is dropped). Each tier serves the timescale it&#39;s good at.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1152.8" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONSEQUENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;b&gt;Benefits&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Each tier optimises for its timescale.&lt;br&gt;&amp;bull; Inspectable memory hierarchy maps to cognitive science vocabulary.&lt;br&gt;&lt;br&gt;&lt;b&gt;Liabilities&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Architecturally heavy; only earns its seat in long-running agents.&lt;br&gt;&amp;bull; Tuning the promotion thresholds is empirical work.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1277.8" width="755" height="225" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;WHAT THIS PATTERN CONSTRAINS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Reads at each tier may only return items at that tier&#39;s compaction level; cross-tier joins go through promotion or rehearsal.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1334.8" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; A flat append-only log is collapsing signal across timescales (sensory, working, recent, episodic, distilled).&lt;br&gt;&amp;bull; Promotion and decay between tiers can be implemented on a schedule.&lt;br&gt;&amp;bull; Working memory needs an explicit cap (e.g. ≤7 items, Global Workspace Theory).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1516.8" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;DO NOT USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; The agent&#39;s memory needs are too short-lived to justify five tiers (use a sliding window or single summary).&lt;br&gt;&amp;bull; No salience or decay function exists to drive promotion and archival cleanly.&lt;br&gt;&amp;bull; Storage and compaction cost across tiers exceeds the quality lift.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1440.8" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;COMPONENTS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Five tiered stores — sensory buffer, working memory (≤7 slots, Global Workspace Theory), short-term verbatim, episodic summaries at 5-10x, and long-term distilled rules&lt;br&gt;&amp;bull; Promotion/decay scheduler — moves items upward when salience or repetition justifies it and archives downward when access falls off&lt;br&gt;&amp;bull; Summariser — compresses short-term blocks into episodic entries and episodic clusters into distilled long-term rules&lt;br&gt;&amp;bull; Salience scorer — drives promotion decisions and feeds the rehearsal path that lifts archived items back&lt;br&gt;&amp;bull; Cross-tier reconciler — resolves conflicts between tiers when the same fact appears at different compaction levels&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1660.8" width="755" height="244" as="geometry" />
        </mxCell>
        <mxCell id="s13" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Tiered storage — fast key-value for sensory/working, document store for short-term, vector + summary store for episodic, structured store for long-term&lt;br&gt;&amp;bull; Summarisation LLM — compresses short-term blocks into episodic entries and episodic clusters into distilled rules&lt;br&gt;&amp;bull; Salience scorer — drives promotion decisions and feeds the rehearsal path that lifts archived items back&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1584.8" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s14" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FAILURE MODES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Threshold mistuning — promotion rules are set by guess, so trivial items reach long-term memory while important ones decay out of short-term.&lt;br&gt;&amp;bull; Stale working set — working memory keeps old items in its few slots, and new salient input has no room.&lt;br&gt;&amp;bull; Lost cross-tier link — a question needs a recent fact and a distilled rule together, but reads stay inside one tier and the join never happens.&lt;br&gt;&amp;bull; Overbuilt for short runs — a short-lived agent carries five tiers of machinery it never uses.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1918.8" width="755" height="187" as="geometry" />
        </mxCell>
        <mxCell id="s15" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EVALUATION METRICS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Per-tier hit rate — fraction of reads served at each tier; signals whether promotion thresholds are tuned&lt;br&gt;&amp;bull; Promotion precision — sampled audit of items moved to long-term that genuinely belong there&lt;br&gt;&amp;bull; Cross-tier conflict rate — frequency of contradictions between tiers requiring rehearsal or reconciliation&lt;br&gt;&amp;bull; Working-set overflow — how often working memory tries to exceed its cap, indicating noise above the salience floor&lt;br&gt;&amp;bull; Tier-storage cost ratio — relative spend across tiers, used to justify the architectural weight&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1766.8" width="755" height="206" as="geometry" />
        </mxCell>
        <mxCell id="s16" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;KNOWN USES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://marco-nissen.com/sparrot/&quot;&gt;Sparrot (author&amp;#x27;s long-running personal agent; single private deployment)&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Memory is staged across sensory / working / short-term / episodic / long-term tiers with explicit decay between tiers, rather than one flat store retrieved by similarity. Single-source evidence: one private deployment by the catalog author.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2119.8" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s17" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;RELATED PATTERNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;i&gt;uses&lt;/i&gt; &lt;b&gt;Episodic Summaries&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;uses&lt;/i&gt; &lt;b&gt;Hippocampal Rehearsal&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;composes-with&lt;/i&gt; &lt;b&gt;Append-Only Thought Stream&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;alternative-to&lt;/i&gt; &lt;b&gt;MemGPT-Style Paging&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;composes-with&lt;/i&gt; &lt;b&gt;Salience Attention Mechanism&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Preoccupation Tracking&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1986.8" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s18" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;REFERENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;a href=&quot;https://arxiv.org/abs/2304.03442&quot;&gt;Generative Agents (memory stream + reflection)&lt;/a&gt; — Park et al., 2023&lt;br&gt;&amp;bull; &lt;a href=&quot;https://www.goodreads.com/book/show/1148175.A_Cognitive_Theory_of_Consciousness&quot;&gt;A Cognitive Theory of Consciousness (Global Workspace Theory)&lt;/a&gt; — Bernard Baars, 1988&lt;br&gt;&amp;bull; &lt;a href=&quot;https://www.sciencedirect.com/science/article/abs/pii/S0079742108604223&quot;&gt;Human Memory: A Proposed System and Its Control Processes&lt;/a&gt; — Richard C. Atkinson, Richard M. Shiffrin, 1968&lt;br&gt;&amp;bull; &lt;a href=&quot;https://www.semanticscholar.org/paper/Episodic-and-semantic-memory-Tulving/d792562462dbb687015954805d31620240db57a1&quot;&gt;Episodic and Semantic Memory&lt;/a&gt; — Endel Tulving, 1972&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2263.8" width="755" height="187" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
