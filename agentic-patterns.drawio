        <UserObject label="yes" mermaidId="e:Gaps-&gt;Author#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.99;exitY=0.19;entryX=0.91;entryY=1;" mermaidBaseValue="yes" id="m9">
          <mxCell edge="1" parent="1" source="m3" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.99;exitY=0.19;entryX=0.91;entryY=1;" target="m0">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="1024.45" y="649.45" />
                <mxPoint x="1024.45" y="568.85" />
                <mxPoint x="1024.45" y="474.3" />
                <mxPoint x="1024.45" y="368.9" />
                <mxPoint x="1024.45" y="277.45" />
              </Array>
