        <UserObject label="" mermaidId="e:INF-&gt;APP#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.38;entryY=0;" mermaidBaseValue="" id="m21">
          <mxCell edge="1" parent="1" source="m16" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.38;entryY=0;" target="m17">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="544.21" y="561.13" />
