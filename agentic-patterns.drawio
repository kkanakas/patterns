        <mxCell id="title" value="&lt;div style=&quot;font-size:24px&quot;&gt;&lt;b&gt;Event-Driven Agent&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#52606d&quot;&gt;Planning &amp;amp; Control Flow &amp;nbsp; | &amp;nbsp; mature &amp;nbsp; | &amp;nbsp; Also known as: Event Subscriber, Reactive Agent, Webhook Agent&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1540" height="58" as="geometry" />
