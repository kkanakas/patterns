        <UserObject label="" mermaidId="e:K-&gt;C#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.88;exitY=0;entryX=0.81;entryY=1;" mermaidBaseValue="" id="m22">
          <mxCell edge="1" parent="1" source="m10" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.88;exitY=0;entryX=0.81;entryY=1;" target="m2">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="1503.4" y="1546.9" />
                <mxPoint x="1503.4" y="1466.3" />
                <mxPoint x="1503.4" y="1385.7" />
                <mxPoint x="1503.4" y="1305.1" />
