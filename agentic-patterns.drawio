        <UserObject label="" mermaidId="e:R-&gt;Gen#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="" id="m17">
          <mxCell edge="1" parent="1" source="m10" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="m11">
            <mxGeometry relative="1" as="geometry">
              <Array as="points" />
