        <UserObject label="Published as postmortem" mermaidId="n:P" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=#fee;strokeColor=#c33;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Published as postmortem" id="m4">
          <mxCell parent="1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=#fee;strokeColor=#c33;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="83.7" width="372.0" x="65.0" y="799.8" as="geometry" />
