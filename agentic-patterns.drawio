        <UserObject label="" mermaidId="e:Chunk-&gt;J#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.55;exitY=1;entryX=0.8;entryY=0;" mermaidBaseValue="" id="m11">
