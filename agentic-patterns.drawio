        <UserObject label="" mermaidId="e:LLM-&gt;Biz#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0;exitY=0.4178082191780822;entryX=1;entryY=0.4178082191780822;curved=1;exitX=0;exitY=0.42;entryX=1;entryY=0.42;" mermaidBaseValue="" id="m7">
