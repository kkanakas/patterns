        <UserObject label="" mermaidId="e:Revise-&gt;Strat#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.54;exitY=0;entryX=0.77;entryY=1;" mermaidBaseValue="" id="m9">
          <mxCell edge="1" parent="1" source="m4" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.54;exitY=0;entryX=0.77;entryY=1;" target="m0">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="674.15" y="615.35" />
                <mxPoint x="674.15" y="519.25" />
                <mxPoint x="674.15" y="438.65" />
