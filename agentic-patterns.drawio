        <UserObject label="Scheduling tools" mermaidId="n:Sch" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Scheduling tools" id="m4">
          <mxCell parent="1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="83.7" width="272.8" x="747.0" y="477.4" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Agent picks billing tool" mermaidId="n:Pick2" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Agent picks billing tool" id="m5">
          <mxCell parent="1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="83.7" width="347.2" x="65.0" y="638.6" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Tool call" mermaidId="n:Call" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Tool call" id="m6">
          <mxCell parent="1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="83.7" width="186.0" x="145.6" y="799.8" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:P-&gt;Pick1#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="" id="m7">
          <mxCell edge="1" parent="1" source="m0" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="m1">
            <mxGeometry relative="1" as="geometry">
              <Array as="points" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:Pick1-&gt;Bil#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="" id="m8">
          <mxCell edge="1" parent="1" source="m1" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0;exitY=1;entryX=0.5;entryY=0;" target="m2">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="238.6" y="438.65" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:Pick1-&gt;Idn#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="" id="m9">
          <mxCell edge="1" parent="1" source="m1" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="m3">
            <mxGeometry relative="1" as="geometry">
              <Array as="points" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:Pick1-&gt;Sch#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.96;entryX=0.5;entryY=0;" mermaidBaseValue="" id="m10">
          <mxCell edge="1" parent="1" source="m1" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.96;entryX=0.5;entryY=0;" target="m4">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="883.4" y="438.65" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:Bil-&gt;Pick2#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="" id="m11">
          <mxCell edge="1" parent="1" source="m2" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="m5">
            <mxGeometry relative="1" as="geometry">
              <Array as="points" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:Pick2-&gt;Call#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="" id="m12">
          <mxCell edge="1" parent="1" source="m5" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="m6">
            <mxGeometry relative="1" as="geometry">
              <Array as="points" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="s0" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;INTENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Organise tools into a tree of categories so the agent first picks a branch and then a specific tool within it.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="928.5" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONTEXT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;An agent has access to dozens or hundreds of tools — every public API the company exposes, every micro-action across many domains (billing, identity, scheduling, search, code, files). Presenting them all in the system prompt blows up the context window and overloads the model&#39;s selection step.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="928.5" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;PROBLEM&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A flat tool list collapses in two ways past roughly 30 tools. Token cost grows linearly in description length × tool count. Selection error rises non-linearly as the model confuses similar tools or misses the right one entirely. Worse, permissions and ownership are flat too — there is no scope at which a team can say &#39;these are the billing tools, this team owns them&#39;. The agent ends up either under-tooled (some tools dropped) or unreliable (the model picks wrong).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1034.5" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FORCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Token cost of tool descriptions scales with catalog size.&lt;br&gt;&amp;bull; Model selection accuracy degrades past a few dozen choices.&lt;br&gt;&amp;bull; Permissions, ownership, and audit naturally group by domain.&lt;br&gt;&amp;bull; The first-stage choice (category) must be cheap enough not to cost what was saved.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1053.5" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;THEREFORE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Therefore: organise tools into a tree of categories and have the agent first pick a category, then pick a specific tool within it, so token cost and selection error scale sub-linearly with catalog size.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1197.5" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;SOLUTION&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Group tools into named categories (billing, identity, scheduling, search, code, files). At the top level the agent sees only the category names with one-line descriptions. After it picks a category, it sees the tools in that branch. Permissions can scope per branch (this user can read but not write billing tools). For very large catalogs nest the tree further. The cost is one extra decoding step at the top; the saving is paying full tool descriptions only for the chosen branch.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1197.5" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;STRUCTURE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;font face=&quot;monospace&quot;&gt;Prompt (category names only) --&amp;gt; Agent picks category --&amp;gt; Tools in chosen branch (billing / identity / scheduling ...) --&amp;gt; Agent picks tool --&amp;gt; Tool call&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1322.5" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EXAMPLE SCENARIO&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;An ops agent has 180 tools spanning eight domains. The system prompt presents only the eight category names. After picking &#39;billing&#39; the agent receives the 24 billing tools. End-to-end latency is one extra decode at the top; total tokens drop ~80% on average and selection accuracy on a 200-trace eval rises from 64% to 91%.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1360.5" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONSEQUENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;b&gt;Benefits&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Token cost stays bounded as the catalog grows.&lt;br&gt;&amp;bull; Selection accuracy improves because the model picks among few items at each level.&lt;br&gt;&amp;bull; Permissions and ownership map onto the tree naturally.&lt;br&gt;&lt;br&gt;&lt;b&gt;Liabilities&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; An extra step per call adds latency and one more decoding decision.&lt;br&gt;&amp;bull; Categories that don&#39;t carve nature at the joints (a tool that spans two domains) need duplication or compromise.&lt;br&gt;&amp;bull; Wrong top-level pick produces a dead-end where the right tool is in a different branch.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1447.5" width="755" height="282" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;WHAT THIS PATTERN CONSTRAINS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A large tool catalog must not be presented as a flat list to the model; tools are organised into named categories and the agent first picks a category before seeing tool-level descriptions.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1504.5" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Tool catalog exceeds roughly 30 tools.&lt;br&gt;&amp;bull; Tools naturally cluster into domain categories.&lt;br&gt;&amp;bull; Permissions or ownership can scope per category.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1743.5" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;DO NOT USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Catalog is small enough to present flat.&lt;br&gt;&amp;bull; Tools span domains so heavily that categorisation is arbitrary.&lt;br&gt;&amp;bull; Latency budget cannot absorb the extra top-level decode.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1610.5" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;COMPONENTS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Tool tree — categories at the top, tools at the leaves&lt;br&gt;&amp;bull; Category-description block — short prompt content for top level&lt;br&gt;&amp;bull; Branch loader — fetches tool descriptions for the chosen branch only&lt;br&gt;&amp;bull; Permission scoping — applies per-branch access policy&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1868.5" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s13" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Tool registry — holds the tree definition and per-branch descriptions&lt;br&gt;&amp;bull; Prompt builder — assembles top-level vs branch-level prompts&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1735.5" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s14" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FAILURE MODES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Wrong branch — the agent picks the billing category when the needed tool sits under identity, and it reaches a dead end with no way to see the right tool.&lt;br&gt;&amp;bull; Straddling tool — a tool that belongs to two domains is placed in only one, and the agent never finds it from the other side.&lt;br&gt;&amp;bull; Vague category names — one-line descriptions at the top level do not separate branches clearly, so the first pick is close to a guess.&lt;br&gt;&amp;bull; Extra hop on hot paths — a simple, frequent call pays the category step every time and adds latency the flat list did not have.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2012.5" width="755" height="206" as="geometry" />
        </mxCell>
        <mxCell id="s15" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EVALUATION METRICS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Token cost per tool call — tokens spent presenting tools&lt;br&gt;&amp;bull; Selection accuracy — fraction of tool picks reviewers judge correct&lt;br&gt;&amp;bull; Dead-end rate — share where wrong top-level pick blocks the right tool&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1841.5" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s16" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;KNOWN USES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://www.oreilly.com/library/view/building-applications-with/9781098176495/ch04.html&quot;&gt;Building Applications with AI Agents (Albada) — Hierarchical Tool Selection&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt;&lt;br&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://arxiv.org/abs/2506.01056&quot;&gt;MCP-Zero hierarchical semantic routing (arXiv 2506.01056)&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2232.5" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s17" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;RELATED PATTERNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Tool Use&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Agent Skills&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Model Context Protocol&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;MCP Bidirectional Bridge&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Agent-Computer Interface&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;composes-with&lt;/i&gt; &lt;b&gt;Tool Transition Fusion&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;alternative-to&lt;/i&gt; &lt;b&gt;One Tool, One Agent&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Composite Service&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;alternative-to&lt;/i&gt; &lt;b&gt;Dependency-Aware Skill Retrieval&lt;/b&gt; — Hierarchical selection narrows a flat catalog by category tree; here the structure followed is the dependency graph, not a topical hierarchy.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1966.5" width="755" height="244" as="geometry" />
        </mxCell>
        <mxCell id="s18" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;REFERENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;a href=&quot;https://www.oreilly.com/library/view/building-applications-with/9781098176495/ch04.html&quot;&gt;Building Applications with AI Agents&lt;/a&gt; — Michael Albada, 2025&lt;br&gt;&amp;bull; &lt;a href=&quot;https://arxiv.org/abs/2506.01056&quot;&gt;MCP-Zero: Active Tool Discovery for Autonomous LLM Agents&lt;/a&gt; — 2025&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2357.5" width="755" height="111" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hint-ladder" name="Hint Ladder">
