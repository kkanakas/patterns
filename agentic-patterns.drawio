        </UserObject>
        <UserObject label="lock-in for N ticks" mermaidId="e:Intense-&gt;Intense#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=#E8E8E88D;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=0.5;entryX=0.5;entryY=0.5;" mermaidBaseValue="lock-in for N ticks" id="m9">
          <mxCell edge="1" parent="1" source="m7" style="startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=#E8E8E88D;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);curved=0;rounded=1;arcSize=20;exitX=1;exitY=1;entryX=1;entryY=1;" target="m7">
            <mxGeometry relative="1" as="geometry">
