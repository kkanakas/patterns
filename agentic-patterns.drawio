        <UserObject label="" mermaidId="e:I-&gt;B#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.62;exitY=0;entryX=1;entryY=0.76;" mermaidBaseValue="" id="m17">
          <mxCell edge="1" parent="1" source="m8" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.62;exitY=0;entryX=1;entryY=0.76;" target="m1">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="1329.47" y="1733.72" />
                <mxPoint x="1329.47" y="1656.28" />
