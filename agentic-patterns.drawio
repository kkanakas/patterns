        <UserObject label="" mermaidId="e:Tight-&gt;Tight#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.33;exitY=1;entryX=0.68;entryY=1;" mermaidBaseValue="" id="m5">
          <mxCell edge="1" parent="1" source="m1" style="startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);curved=0;rounded=1;arcSize=20;exitX=0.325;exitY=1;entryX=0.675;entryY=1;" target="m1">
            <mxGeometry relative="1" as="geometry">
