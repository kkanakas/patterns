        <UserObject label="Old clients ignore unknown extensions;nschema_version bump = breaking change" mermaidId="n:_note_0" mermaidBaseStyle="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff5ad;strokeColor=#aaaa33;strokeWidth=1.3;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Old clients ignore unknown extensions;nschema_version bump = breaking change" id="m9">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff5ad;strokeColor=#aaaa33;strokeWidth=1.3;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="102.3" width="359.6" x="77.4" y="155.0" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="extensions" mermaidId="e:Envelope-&gt;Extensions#0" mermaidBaseStyle="curved=1;startArrow=mermaidDiamond;startSize=17;startFill=0;endArrow=none;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#ECECFF,#1f2020);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="extensions" id="m10">
          <mxCell edge="1" parent="1" source="m0" style="curved=1;startArrow=mermaidDiamond;startSize=17;startFill=0;endArrow=none;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#ECECFF,#1f2020);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="m5">
            <mxGeometry relative="1" as="geometry">
              <Array as="points" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:_note_0-&gt;Envelope#0" mermaidBaseStyle="curved=1;dashed=1;startArrow=none;endArrow=none;strokeColor=light-dark(#333333,#cccccc);exitX=0.47;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="" id="m11">
          <mxCell edge="1" parent="1" source="m9" style="curved=1;dashed=1;startArrow=none;endArrow=none;strokeColor=light-dark(#333333,#cccccc);exitX=0.47;exitY=1;entryX=0.5;entryY=0;fixDash=1;" target="m0">
            <mxGeometry relative="1" as="geometry">
              <Array as="points" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="s0" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;INTENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Build schemas that evolve without breaking old clients via reserved namespaces and extension blocks.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="978.1" width="755" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONTEXT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A team owns a data format that lives for years and is read by clients of different ages — exported files, API payloads, event records in a queue. New fields show up regularly because the product evolves, and the team cannot reasonably upgrade every client at the same moment a new field is added. They need a way to add fields, and to let vendors add their own extensions, without forcing a coordinated release.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="978.1" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;PROBLEM&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A rigid schema that lists exactly which fields are allowed will reject any payload that contains a new field, which means every addition becomes a breaking change for every existing client. The obvious workaround — accepting anything and validating nothing — turns the schema into mush, lets typos through, and makes it impossible to tell deliberate extensions apart from accidents. The team has to choose between cascading breaking changes and losing the schema&#39;s value as a contract, and neither is acceptable for a long-lived format.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1070.1" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FORCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Old clients should ignore new fields, not error.&lt;br&gt;&amp;bull; New fields should be discoverable, not hidden.&lt;br&gt;&amp;bull; Versioning policy must be agreed upfront.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1141.1" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;THEREFORE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Therefore: wrap payloads in a versioned envelope with reserved extension namespaces, so that old clients ignore new fields and &lt;font face=&quot;monospace&quot;&gt;schema_version&lt;/font&gt; becomes the only breaking-change signal.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1252.1" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;SOLUTION&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Define a versioned envelope (&lt;font face=&quot;monospace&quot;&gt;{schema_version, type, payload}&lt;/font&gt;). Reserve namespaces for extensions (&lt;font face=&quot;monospace&quot;&gt;x-vendor.foo&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;extensions: {...}&lt;/font&gt;). Old clients ignore unknown extensions. Bumps to schema_version are the only breaking-change signal.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1266.1" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;STRUCTURE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;font face=&quot;monospace&quot;&gt;Producer -&amp;gt; Envelope {schema_version, type, payload, extensions: {x-vendor.*}} -&amp;gt; Client: known version -&amp;gt; validate core payload; unknown extension -&amp;gt; ignore; schema_version bump -&amp;gt; treat as breaking change&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1358.1" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EXAMPLE SCENARIO&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A typed event stream between agent and client ships v1; six months later the client team needs three new fields and a vendor-specific extension. Without extensibility the schema breaks every old client. The team had used a versioned envelope (&lt;font face=&quot;monospace&quot;&gt;{schema_version, type, payload, extensions}&lt;/font&gt;) with reserved &lt;font face=&quot;monospace&quot;&gt;x-vendor.*&lt;/font&gt; namespaces from day one; adding the new fields and extensions ships without breaking older clients, and a &lt;font face=&quot;monospace&quot;&gt;schema_version&lt;/font&gt; bump is reserved for genuine incompatibilities.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1391.1" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONSEQUENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;b&gt;Benefits&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Long-lived format with low breakage.&lt;br&gt;&amp;bull; Per-vendor extensions don&#39;t pollute the core.&lt;br&gt;&lt;br&gt;&lt;b&gt;Liabilities&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Extension proliferation is a real risk.&lt;br&gt;&amp;bull; Versioning discipline must be enforced socially or technically.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1483.1" width="755" height="225" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;WHAT THIS PATTERN CONSTRAINS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Clients cannot rely on extension fields outside their declared namespace.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1554.1" width="755" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Schemas are long-lived and will accumulate fields over time.&lt;br&gt;&amp;bull; Multiple clients of different ages must coexist with the same data format.&lt;br&gt;&amp;bull; Breaking-change cost across clients is high.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1722.1" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;DO NOT USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; The schema is internal, short-lived, and a single client owns it.&lt;br&gt;&amp;bull; Strict validation of all fields is required (no unknown extensions allowed).&lt;br&gt;&amp;bull; Versioning discipline cannot be enforced and the envelope would rot.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1646.1" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;COMPONENTS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Versioned envelope — wraps payloads with schema_version, type, and payload so breaking changes are explicit&lt;br&gt;&amp;bull; Reserved extension namespace — declared range (e.g. x-vendor.*, extensions: {...}) where new fields can land without colliding&lt;br&gt;&amp;bull; Forward-compatible reader — ignores unknown extension keys instead of erroring on them&lt;br&gt;&amp;bull; Schema-version arbiter — enforces that only schema_version bumps signal breaking changes&lt;br&gt;&amp;bull; Vendor-extension registry — optional governance layer recording which vendor owns which namespace&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1847.1" width="755" height="187" as="geometry" />
        </mxCell>
        <mxCell id="s13" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Protocol Buffers with reserved field numbers — language-neutral schema with built-in forward compatibility&lt;br&gt;&amp;bull; JSON Schema or OpenAPI with x-* extension keys — declares the reserved namespace inside the contract&lt;br&gt;&amp;bull; Schema-evolution linter — flags additions that would require a schema_version bump&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1771.1" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s14" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FAILURE MODES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Extension sprawl — every vendor adds its own &lt;font face=&quot;monospace&quot;&gt;x-&lt;/font&gt; fields, nobody retires them, and the payload fills with overlapping extensions.&lt;br&gt;&amp;bull; Silent breaking change — a producer changes the meaning of a core field without bumping schema_version, and old clients misread it.&lt;br&gt;&amp;bull; Cross-namespace reliance — a client starts depending on another vendor&#39;s extension field, and breaks when that vendor changes it.&lt;br&gt;&amp;bull; Typo as extension — a misspelled field lands in the extensions block, is ignored by clients, and the intended value is lost without an error.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2048.1" width="755" height="206" as="geometry" />
        </mxCell>
        <mxCell id="s15" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EVALUATION METRICS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Old-client read success rate after additions — fraction of pre-change clients that still parse new payloads cleanly&lt;br&gt;&amp;bull; Breaking-change incidence per release — should approach zero between schema_version bumps&lt;br&gt;&amp;bull; Extension-namespace collision count — distinct vendors writing to the same x-* key; flags governance gaps&lt;br&gt;&amp;bull; Unknown-field drop rate — extensions silently lost on round-trip, which defeats the pattern&lt;br&gt;&amp;bull; Schema-version cadence — how often genuine breaking changes ship; informs deprecation policy&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1934.1" width="755" height="187" as="geometry" />
        </mxCell>
        <mxCell id="s16" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;KNOWN USES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;b&gt;Weft&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Versioned envelope: {weft_version, type, exported_at, exported_from, items}.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2268.1" width="755" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s17" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;RELATED PATTERNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Polymorphic Record&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Translation Layer&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2135.1" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s18" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;REFERENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;a href=&quot;https://protobuf.dev/programming-guides/proto3/#updating&quot;&gt;Protocol Buffers backwards compatibility&lt;/a&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2360.1" width="755" height="78" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
