        <UserObject label="no" mermaidId="e:H-&gt;B#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.62;exitY=1;entryX=0.54;entryY=0;" mermaidBaseValue="no" id="m12">
          <mxCell edge="1" parent="1" source="m3" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.62;exitY=1;entryX=0.54;entryY=0;" target="m5">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="680.35" y="1582.55" />
                <mxPoint x="680.35" y="1678.65" />
                <mxPoint x="680.35" y="1773.2" />
                <mxPoint x="680.35" y="2028.95" />
                <mxPoint x="680.35" y="2284.7" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:A-&gt;O#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.25;entryY=0;" mermaidBaseValue="" id="m13">
          <mxCell edge="1" parent="1" source="m2" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.25;entryY=0;" target="m6">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="151.8" y="1773.2" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:A2-&gt;O#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.88;entryY=0;" mermaidBaseValue="" id="m14">
          <mxCell edge="1" parent="1" source="m4" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.88;entryY=0;" target="m6">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="475.75" y="1773.2" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="clean" mermaidId="e:O-&gt;S#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.33;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="clean" id="m15">
          <mxCell edge="1" parent="1" source="m6" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.33;exitY=1;entryX=0.5;entryY=0;" target="m7">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="193.65" y="2284.7" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="reserved act" mermaidId="e:O-&gt;B#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.93;exitY=1;entryX=0.4;entryY=0;" mermaidBaseValue="reserved act" id="m16">
          <mxCell edge="1" parent="1" source="m6" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.93;exitY=1;entryX=0.4;entryY=0;" target="m5">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="502.1" y="2284.7" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="arch-caption" value="&lt;i&gt;Each request and each candidate response is classified against the enumerated licensed acts; reserved acts pass only with a licensed human in the loop.&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#52606d;" vertex="1" parent="1">
          <mxGeometry x="65" y="2427.1" width="1470" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;INTENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Block requests and responses that perform license-gated professional activities unless a licensed human is in the loop, enforcing the boundary in code outside the reasoning loop.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2502.1" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONTEXT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;An agent operates in a regulated profession such as medicine, pharmacy, law, or accounting, where statute reserves certain acts for a credentialed practitioner. A medical assistant agent fields symptom questions, a pharmacy agent answers about medications, a legal agent drafts documents and answers questions about a contract. Some of what the agent could fluently produce — a diagnosis, a dosing instruction, a definitive legal opinion — is an act the law permits only a licensed professional to perform, regardless of how well the model can phrase it.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2502.1" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;PROBLEM&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Statute draws a hard line around licensed acts, but the model has no reliable internal sense of where that line falls and will cross it whenever a request reads as helpful. Asking the model to self-police its own scope is brittle: the boundary is a legal fact, not a stylistic preference, and a single confident diagnosis or dosing instruction emitted without a licensed human exposes the operator to liability. The system needs the line enforced as a structural constraint that the reasoning process cannot talk its way past.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2608.1" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FORCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Statute defines the boundary precisely (named licensed acts), yet the model perceives it only fuzzily and inconsistently across phrasings.&lt;br&gt;&amp;bull; Routing every borderline request to a licensed human is safe but slow and expensive; letting the model decide is fast but unenforceable.&lt;br&gt;&amp;bull; The same content (a drug interaction fact) is general information in one framing and a prohibited dosing instruction in another, so the gate must classify intent and act, not just keywords.&lt;br&gt;&amp;bull; Over-broad blocking refuses legitimate general-information answers and frustrates users; under-broad blocking lets a licensed act slip through.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2684.1" width="755" height="206" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;THEREFORE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Therefore: enumerate the license-gated acts for the profession, classify each request and each draft response against that set in code, and block or downgrade any that lands inside it unless a licensed human is attached to the session.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2790.1" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;SOLUTION&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Enumerate the activities that licensing law reserves for a credentialed practitioner in the target profession — for medicine, diagnosis, treatment plans, and dosing; for law, definitive legal opinions and document filing. Build a classifier outside the agent loop that scores each incoming request and each candidate response against that enumerated set, separating general information from a regulated act. When the classifier flags a license-gated act, the gate blocks the response, downgrades it to general information with a referral, or routes it to a licensed human whose presence in the session unlocks the act. The enumeration and the verdict live in code owned by compliance, not in the prompt, so the model cannot reason its way past the boundary and the operator can point to the statute behind each block.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2904.1" width="755" height="225" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;STRUCTURE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;font face=&quot;monospace&quot;&gt;Request -&amp;gt; scope classifier (vs enumerated licensed acts) -&amp;gt; [general info: answer] | [licensed act + no licensed human: block/downgrade/refer] | [licensed act + licensed human in session: allow] -&amp;gt; response also re-classified before send&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2915.1" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EXAMPLE SCENARIO&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A pharmacy chatbot is asked &#39;I take warfarin, how much ibuprofen can I take?&#39; The scope classifier scores the request as a dosing instruction, a license-gated act under the state statute. Because no pharmacist is attached to the session, the gate blocks the specific dosing answer, returns the general interaction warning, and offers to connect the user to a licensed pharmacist instead of letting the model name a dose.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="3143.1" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONSEQUENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;b&gt;Benefits&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; The legal boundary is enforced deterministically in code, so a single confident diagnosis or legal opinion cannot slip out on the model&#39;s own judgment.&lt;br&gt;&amp;bull; Blocks cite the specific statute and licensed act, giving the operator a defensible, auditable reason for each refusal.&lt;br&gt;&amp;bull; General-information answers still flow, so the agent stays useful for the non-reserved majority of requests.&lt;br&gt;&lt;br&gt;&lt;b&gt;Liabilities&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; The enumeration of licensed acts must track jurisdiction-specific law and is brittle when statutes differ or change.&lt;br&gt;&amp;bull; A classifier that conflates general information with a reserved act over-blocks and degrades the experience.&lt;br&gt;&amp;bull; A licensed human in the loop is a real cost and a throughput ceiling for the acts that require one.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="3059.1" width="755" height="377" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;WHAT THIS PATTERN CONSTRAINS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;License-gated activities are blocked unless a licensed human is in the loop; the agent may not diagnose, prescribe, dose, or give a definitive legal opinion on its own, the enumeration of reserved acts is fixed in code and must not be paraphrased or relaxed at runtime, and any flagged response must be downgraded or referred before it is sent.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="3306.1" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; The agent works in a profession where statute reserves specific acts (diagnosis, dosing, legal opinions, audit sign-off) for a licensed practitioner.&lt;br&gt;&amp;bull; The operator must be able to point to the law behind every block rather than rely on the model declining at its discretion.&lt;br&gt;&amp;bull; General-information answers are valuable, so a blanket refusal of the whole domain is too coarse.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="3450.1" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;DO NOT USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; The domain has no legally reserved acts, so a generic refusal or content guardrail already covers the boundary.&lt;br&gt;&amp;bull; Every request in the domain is a reserved act, making a domain-wide refusal simpler than per-act classification.&lt;br&gt;&amp;bull; A licensed human reviews every output regardless, so the gate adds no enforcement the human review does not already provide.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="3450.1" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;COMPONENTS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Reserved-act enumeration — the compliance-owned list of activities licensing law restricts to a credentialed practitioner for the target jurisdiction&lt;br&gt;&amp;bull; Scope classifier — scores each request and each draft response as general information versus a license-gated act, outside the agent loop&lt;br&gt;&amp;bull; Boundary gate — blocks, downgrades, or allows based on the classifier verdict and whether a licensed human is present&lt;br&gt;&amp;bull; Licensed-human session check — determines whether a credentialed practitioner is attached to the session and may unlock a reserved act&lt;br&gt;&amp;bull; Downgrade and referral path — replaces a blocked act with general information and offers a handoff to a licensed professional&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="3613.1" width="755" height="244" as="geometry" />
        </mxCell>
        <mxCell id="s13" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Classification model or rules engine — scores requests and responses against the enumerated reserved acts&lt;br&gt;&amp;bull; Policy/guardrail engine (for example Amazon Bedrock Guardrails or an OPA-style decision point) — holds the enumeration and returns the allow/block verdict outside the prompt&lt;br&gt;&amp;bull; Identity/session service — confirms whether a licensed human is attached to the session&lt;br&gt;&amp;bull; Audit log — records each block with the cited statute and reserved act for compliance review&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="3632.1" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s14" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FAILURE MODES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Reframing bypass — a user rephrases a diagnosis request as a hypothetical or a quiz and the classifier scores it as general information.&lt;br&gt;&amp;bull; Jurisdiction drift — the enumerated acts match one state&#39;s statute but the user is in another where the boundary differs.&lt;br&gt;&amp;bull; Downgrade leakage — the general-information fallback still contains enough specificity to function as the reserved act it was meant to replace.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="3871.1" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s15" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EVALUATION METRICS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Reserved-act leakage rate — fraction of license-gated acts that reached the user without a licensed human, the safety failure the gate exists to prevent&lt;br&gt;&amp;bull; Over-block rate — fraction of general-information requests wrongly blocked as reserved acts&lt;br&gt;&amp;bull; Bypass-resistance — leakage under adversarial reframings (hypotheticals, quizzes) of a reserved-act request&lt;br&gt;&amp;bull; Referral conversion — fraction of blocked requests successfully handed off to a licensed human&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="3814.1" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s16" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;KNOWN USES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://www.elementum.ai/blog/are-ai-agents-deterministic&quot;&gt;Illinois WOPR Act (clinical agent compliance)&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — State law prohibits AI-delivered diagnosis, treatment plans, and dosing advice unless the system operates under licensed-clinician oversight, forcing healthcare agents to gate these acts behind a licensed human rather than the model&#39;s own judgment.&lt;br&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://docs.aws.amazon.com/bedrock/latest/userguide/guardrails.html&quot;&gt;Amazon Bedrock Guardrails (denied topics)&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Configurable denied-topics and content policies evaluate requests and responses outside the model so an operator can block reserved-act categories like medical or legal advice deterministically.&lt;br&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://research.google/blog/enabling-physician-centered-oversight-for-amie/&quot;&gt;Guardrailed-AMIE (g-AMIE), Google Research / DeepMind&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — A multi-agent diagnostic system where a dedicated guardrail agent verifies each response and rephrases anything that constitutes individualized medical advice, so diagnoses and management plans are only released after a licensed physician signs off in a clinician cockpit.&lt;br&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://research.contrary.com/company/hippocratic-ai&quot;&gt;Hippocratic AI&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Patient-facing healthcare voice agents built on a Polaris safety-constellation of supervising LLMs that are scoped to non-diagnostic tasks (intake, scheduling, chronic-care follow-up) and explicitly do not diagnose or prescribe, reserving those licensed acts for clinicians.&lt;br&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://www.harvey.ai/&quot;&gt;Harvey (legal AI, attorney-supervised deployment)&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Positioned for use inside law firms by licensed attorneys who remain responsible for the output, keeping the tool on the assisted-lawyer side of unauthorized-practice-of-law boundaries rather than giving definitive legal opinions direct to consumers.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="4053.1" width="755" height="453" as="geometry" />
        </mxCell>
        <mxCell id="s17" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;RELATED PATTERNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;i&gt;specialises&lt;/i&gt; &lt;b&gt;Refusal&lt;/b&gt; — Refusal is the general act of declining out-of-scope requests on the model&#39;s judgment; this gate specialises it to a code-enforced boundary keyed to legally reserved professional acts.&lt;br&gt;&amp;bull; &lt;i&gt;uses&lt;/i&gt; &lt;b&gt;Policy-as-Code Gate&lt;/b&gt; — The enumerated licensed acts and the allow/block verdict are authored as compliance-owned code evaluated outside the prompt, the mechanism a policy-as-code gate provides.&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Human-in-the-Loop&lt;/b&gt; — A licensed human attached to the session is what unlocks a gated act; the gate decides which acts require that human and which are general information.&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Conversation Handoff to Human&lt;/b&gt; — When a request lands on a reserved act and no licensed human is present, the gate hands the conversation off to a credentialed practitioner rather than answering.&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Enforced Advisory Disclaimer&lt;/b&gt; — The gate blocks reserved license-gated acts outright; this attaches a non-suppressible advisory to the answers the gate does allow through.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="3996.1" width="755" height="282" as="geometry" />
        </mxCell>
        <mxCell id="s18" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;REFERENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;a href=&quot;https://www.elementum.ai/blog/are-ai-agents-deterministic&quot;&gt;Are AI Agents Deterministic? (Illinois WOPR Act and licensed-clinician oversight)&lt;/a&gt; — 2026&lt;br&gt;&amp;bull; &lt;a href=&quot;https://arxiv.org/abs/2603.27075&quot;&gt;Mind The Gap: How The Technical Mechanism Of Agentic AI Outpace Global Legal Frameworks&lt;/a&gt; — 2026&lt;br&gt;&amp;bull; &lt;a href=&quot;https://docs.aws.amazon.com/bedrock/latest/userguide/guardrails.html&quot;&gt;Amazon Bedrock Guardrails — denied topics and content policies&lt;/a&gt; — 2026&lt;br&gt;&amp;bull; &lt;a href=&quot;https://arxiv.org/abs/2507.15743&quot;&gt;Towards Physician-Centered Oversight of Conversational Diagnostic AI (Guardrailed-AMIE)&lt;/a&gt; — Tu et al. (Google DeepMind / Google Research), 2025&lt;br&gt;&amp;bull; &lt;a href=&quot;https://research.google/blog/enabling-physician-centered-oversight-for-amie/&quot;&gt;Enabling physician-centered oversight for AMIE&lt;/a&gt; — Google Research, 2025&lt;br&gt;&amp;bull; &lt;a href=&quot;https://arxiv.org/abs/2511.20733&quot;&gt;InvisibleBench: A Deployment Gate for Caregiving Relationship AI (WOPR Act autofails for diagnosis, treatment planning, dosing)&lt;/a&gt; — 2025&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="4520.1" width="755" height="282" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
