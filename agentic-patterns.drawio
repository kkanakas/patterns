        <UserObject label="" mermaidId="e:T-&gt;M#0" mermaidBaseStyle="curved=1;startArrow=block;startSize=7;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.1;entryX=0;entryY=0.51;" mermaidBaseValue="" id="m5">
