          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:FS-&gt;SAND#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.48314606741573035;exitY=1;entryX=0.46685082872928174;entryY=0;curved=1;exitX=0.31;exitY=1;entryX=0.47;entryY=0;" mermaidBaseValue="" id="m13">
          <mxCell edge="1" parent="1" source="m0" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.31;exitY=1;entryX=0.47;entryY=0;" target="m6">
            <mxGeometry relative="1" as="geometry">
              <mxPoint as="offset" />
              <Array as="points" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="only printed / saved output" mermaidId="e:SAND-&gt;A#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0;exitY=0.98;entryX=0.5;entryY=0;" mermaidBaseValue="only printed / saved output" id="m14">
          <mxCell edge="1" parent="1" source="m6" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0;exitY=0.98;entryX=0.5;entryY=0;" target="m4">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="189.0" y="906.75" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="large intermediate data stays in sandbox memory" mermaidId="e:SAND-&gt;SAND#0" mermaidBaseStyle="curved=1;dashed=1;dashPattern=2 3;fixDash=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.22;exitY=1;entryX=0.77;entryY=1;" mermaidBaseValue="large intermediate data stays in sandbox memory" id="m15">
          <mxCell edge="1" parent="1" source="m6" style="dashed=1;dashPattern=2 3;fixDash=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);curved=0;rounded=1;arcSize=20;exitX=0.221;exitY=1;entryX=0.773;entryY=1;" target="m6">
            <mxGeometry relative="1" as="geometry">
              <mxPoint y="164.3" as="offset" />
              <Array as="points">
                <mxPoint x="449.4" y="890.17" />
                <mxPoint x="604.4" y="890.17" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="arch-caption" value="&lt;i&gt;Tool wrappers live on a readable filesystem; the agent ships code that chains them in the sandbox, so bulk data never enters the context.&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#52606d;" vertex="1" parent="1">
          <mxGeometry x="65" y="1269.25" width="1470" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;INTENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Materialize MCP servers as a directory of typed code wrappers so the agent writes code that imports them and large tool outputs flow between calls inside the sandbox without ever entering the model&#39;s context window.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1344.25" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONTEXT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A team is running an agent that is connected to many Model Context Protocol (MCP) servers at once: a Google Drive server, a Slack server, an internal Postgres server, a GitHub server. Each server exposes tens or hundreds of tools with verbose JSON outputs. The agent already has a code-execution sandbox available (a Python or TypeScript runtime it can use as its action channel).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1344.25" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;PROBLEM&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Conventional tool calling loads every advertised tool schema into the system prompt and routes every tool result back through the model&#39;s context window, even when the model is only going to pass that result straight to the next tool. A single workflow that joins a 5 megabyte spreadsheet with a paginated Slack thread can burn six-figure token counts before any actual reasoning happens, and most of those tokens are plumbing the model never has to read.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1469.25" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FORCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Tool schemas are static and discoverable on the filesystem, but model context is scarce and per-turn-priced.&lt;br&gt;&amp;bull; Intermediate data often flows tool-to-tool with no semantic reasoning in between, yet conventional MCP routes every byte through the model.&lt;br&gt;&amp;bull; Code execution can manipulate large objects locally for free, but only if tool wrappers exist as callable code.&lt;br&gt;&amp;bull; Typed wrappers give the model autocomplete-like affordances, but typing every tool by hand does not scale; wrappers must be generated from MCP schemas.&lt;br&gt;&amp;bull; Security boundaries previously enforced by the model reading tool output now shift to the sandbox; untrusted data may flow without an LLM checkpoint.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1488.25" width="755" height="244" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;THEREFORE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Therefore: generate a directory of typed code modules from each MCP server&#39;s schema, expose only that filesystem to the agent, and let the agent write code that imports the wrappers — keeping large intermediate results inside the sandbox so only the final summary returns to context.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1632.25" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;SOLUTION&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;At connection time, walk each MCP server&#39;s tool list and emit a file per tool (e.g. servers/gdrive/getDocument.ts, servers/slack/listChannels.ts) with full type signatures derived from the JSON schema. Expose this tree to the agent as a readable filesystem and let it explore via standard list/read primitives rather than loaded schemas. The agent then writes execution code — a short script that imports the wrappers, chains calls, transforms results in-memory, and prints only the final answer. Tool outputs live in sandbox variables; only what the script prints (or saves to a designated output) crosses back into model context. Pair with progressive disclosure: the model reads only the tool files it intends to use.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1746.25" width="755" height="206" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;STRUCTURE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;font face=&quot;monospace&quot;&gt;Agent &amp;lt;-&amp;gt; Model context (small) | Sandbox runtime executes generated code | Tool wrapper tree (one file per MCP tool, typed) | MCP servers behind wrappers | Large intermediate data stays in sandbox memory; only printed output returns to context.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1757.25" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EXAMPLE SCENARIO&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;An assistant must take meeting notes from Google Drive, identify action items, and post them in the right Slack channels. The naive approach pulls the entire transcript into context, then pulls the channel list, then formats messages — burning ~150K tokens. With MCP-as-Code-API, the model writes a short TypeScript that imports gdrive.getDocument and slack.postMessage, filters action items in-process, and prints only a confirmation. Total tokens dropped to ~2K because the transcript never crossed the context boundary.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1966.25" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONSEQUENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;b&gt;Benefits&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Massive token reduction — Anthropic reports 98.7% on representative workflows.&lt;br&gt;&amp;bull; Large tool outputs (sheets, transcripts, binaries) never enter context.&lt;br&gt;&amp;bull; Composition becomes ordinary programming: filters, joins, retries are code, not prompted loops.&lt;br&gt;&amp;bull; Tool discovery becomes filesystem navigation, reusing well-trained model behaviour.&lt;br&gt;&amp;bull; Schemas are loaded on demand rather than all upfront.&lt;br&gt;&lt;br&gt;&lt;b&gt;Liabilities&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Requires a working code-execution sandbox with network egress controls.&lt;br&gt;&amp;bull; Model must be strong at code generation in the chosen runtime.&lt;br&gt;&amp;bull; Untrusted data flowing through code without LLM checkpoints widens the prompt-injection surface inside the sandbox.&lt;br&gt;&amp;bull; Wrapper generation must stay in sync with upstream MCP schema changes.&lt;br&gt;&amp;bull; Debugging failures spans two layers — generated code and tool wrappers — rather than one tool call.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1901.25" width="755" height="377" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;WHAT THIS PATTERN CONSTRAINS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;The model must not request raw tool outputs into context when they exceed a configured size; it must route large outputs through sandbox variables and return only printed summaries. It must not invent wrapper modules — only those materialized on the filesystem from real MCP schemas are callable.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2148.25" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Workflows chain many MCP tools and intermediate data is large.&lt;br&gt;&amp;bull; A code-execution sandbox is already part of the agent stack.&lt;br&gt;&amp;bull; Token cost or latency dominated by tool-output round-tripping.&lt;br&gt;&amp;bull; Tool surface is too large to fit all schemas in prompt.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2292.25" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;DO NOT USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Only a handful of tools are used and outputs are small.&lt;br&gt;&amp;bull; No code sandbox is available or code generation in the runtime is weak.&lt;br&gt;&amp;bull; Each tool result genuinely requires LLM reasoning before the next call.&lt;br&gt;&amp;bull; Compliance forbids untrusted data flowing without per-step LLM inspection.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2273.25" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;COMPONENTS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Wrapper Generator — walks each MCP server&#39;s tool list and emits a typed code file per tool&lt;br&gt;&amp;bull; Tool Wrapper Tree — filesystem-shaped directory of typed wrappers grouped by server&lt;br&gt;&amp;bull; Agent — writes execution code that imports wrappers instead of calling tools through the model&lt;br&gt;&amp;bull; Sandbox Runtime — executes the agent-authored script and routes wrapper calls to MCP servers&lt;br&gt;&amp;bull; Filesystem Surface — exposes the wrapper tree to the agent via list and read primitives instead of preloaded schemas&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2436.25" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s13" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; JSON-Schema-to-TypeScript (or Python) compiler — generates the typed wrappers from MCP tool schemas&lt;br&gt;&amp;bull; Sandboxed code runtime (Deno, Node, or Python sandbox) — executes the agent-authored scripts that import wrappers&lt;br&gt;&amp;bull; MCP client library — carries wrapper calls to the underlying servers&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2417.25" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s14" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FAILURE MODES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Wrapper drift — an upstream MCP schema changes and the generated file still has the old signature, so the agent&#39;s script fails on a call that looked valid.&lt;br&gt;&amp;bull; Invented module — the agent imports a wrapper that was never generated, guessing from tool names instead of reading the file tree.&lt;br&gt;&amp;bull; Raw output in context — the script prints a whole spreadsheet instead of a summary, and the token saving is lost.&lt;br&gt;&amp;bull; Unchecked data path — untrusted content moves between tools inside the sandbox with no model checkpoint, and an injected instruction reaches a write tool.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2618.25" width="755" height="206" as="geometry" />
        </mxCell>
        <mxCell id="s15" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EVALUATION METRICS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Context tokens versus eager-schema baseline — reduction from leaving schemas off the prompt&lt;br&gt;&amp;bull; Wrapper-discovery hit rate — fraction of needed tools the agent locates via list and read&lt;br&gt;&amp;bull; Inter-tool data size kept in sandbox — payload that never enters the model context&lt;br&gt;&amp;bull; Generated-script validity rate — share of authored scripts that parse and run end to end&lt;br&gt;&amp;bull; End-to-end task success on data-heavy workflows — headline value of moving plumbing into code&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2561.25" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s16" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;KNOWN USES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://www.anthropic.com/engineering/code-execution-with-mcp&quot;&gt;Anthropic Claude (engineering blog reference implementation)&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Reports ~98.7% token reduction on representative MCP workflows.&lt;br&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://developers.cloudflare.com/agents/api-reference/codemode&quot;&gt;Cloudflare Code Mode&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Exposes MCP tools as a typed code API the model writes against.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2838.25" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s17" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;RELATED PATTERNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;i&gt;specialises&lt;/i&gt; &lt;b&gt;Model Context Protocol&lt;/b&gt; — Materializes the MCP protocol as a typed code surface instead of inline tool calls.&lt;br&gt;&amp;bull; &lt;i&gt;composes-with&lt;/i&gt; &lt;b&gt;Code-as-Action Agent&lt;/b&gt; — The agent emits code as its action — but the action imports MCP-derived wrappers rather than ad-hoc helpers.&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Tool Search Lazy Loading&lt;/b&gt; — Filesystem layout enables on-demand schema loading: the model reads only the wrapper files for tools it plans to call.&lt;br&gt;&amp;bull; &lt;i&gt;alternative-to&lt;/i&gt; &lt;b&gt;Tool Loadout&lt;/b&gt; — Loadout pre-selects a static tool subset; MCP-as-Code-API lets the model self-select at code-write time.&lt;br&gt;&amp;bull; &lt;i&gt;uses&lt;/i&gt; &lt;b&gt;Sandbox Isolation&lt;/b&gt; — Relies on a code sandbox to hold large intermediate state outside model context.&lt;br&gt;&amp;bull; &lt;i&gt;alternative-to&lt;/i&gt; &lt;b&gt;Tool Explosion&lt;/b&gt; — Avoids the bloat by never loading all schemas into prompt at once.&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;MCP Bidirectional Bridge&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Direct API Wrapper&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Composite Service&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2724.25" width="755" height="320" as="geometry" />
        </mxCell>
