        </UserObject>
        <UserObject label="time passes" mermaidId="e:Focused-&gt;WindingDown#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=#E8E8E88D;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.64;entryY=0;" mermaidBaseValue="time passes" id="m13">
          <mxCell edge="1" parent="1" source="m3" style="curved=1;startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=#E8E8E88D;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.64;entryY=0;" target="m4">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="221.55" y="708.35" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:WindingDown-&gt;root_end#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="" id="m14">
          <mxCell edge="1" parent="1" source="m4" style="curved=1;startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="m6">
            <mxGeometry relative="1" as="geometry">
              <Array as="points" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="regains focus" mermaidId="e:Distracted-&gt;Focused#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=#E8E8E88D;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.86;entryY=0;" mermaidBaseValue="regains focus" id="m15">
          <mxCell edge="1" parent="1" source="m5" style="curved=1;startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=#E8E8E88D;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.86;entryY=0;" target="m3">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="337.8" y="539.4" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="s0" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;INTENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Infer the human&#39;s attentional state (just-woke, focused, winding-down, distracted) from message timing and tone, and adapt response shape so the agent meets the person where they actually are.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="967.25" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONTEXT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A team is building a personal agent that talks to the same human across an entire day. The user is in different attentional modes at different hours — just waking up, deep in focused work, winding down before sleep, distracted in a meeting, fully present in a conversation. The agent sees only timing and text, but those signals carry information about which mode the user is in if the agent bothers to read them.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="967.25" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;PROBLEM&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A stateless agent that treats every incoming turn as equal-weight produces the same kind of response at six in the morning after twelve hours of silence as it does mid-afternoon in the middle of a working session. A chirpy &#39;hi, what can I help with today?&#39; greeting lands as friendly in one moment and grating in another, and the user has no way to convey the difference short of typing it out. The team has to choose between ignoring attentional state and asking the user to keep declaring it, and neither feels right.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1073.25" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FORCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; The signals (timing gap, message length, punctuation, single emoji) are noisy individually but informative in combination.&lt;br&gt;&amp;bull; Heuristics drift; new humans have different signatures.&lt;br&gt;&amp;bull; Misreading is mildly costly; ignoring entirely is worse.&lt;br&gt;&amp;bull; Detection should not slow the response.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1130.25" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;THEREFORE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Therefore: classify each incoming turn into an attentional-state code (just-woke / focused / winding-down / distracted / present) from timing and tone, and key the reply shape off that code, so that the agent meets the person where they actually are.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1255.25" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;SOLUTION&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;On every incoming user message, compute a small feature set: time-of-day relative to a known anchor, gap since last message, message length and punctuation density, presence of a single emoji or interjection. Map to one of a small mode set (&#39;just-woke&#39;, &#39;focused&#39;, &#39;winding-down&#39;, &#39;distracted&#39;, &#39;present&#39;). Adjust response shape: shorter on winding-down; one anchor surface on just-woke; deeper engagement on focused; hold on distracted. Make the mode visible in agent telemetry so it can be tuned.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1293.25" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;STRUCTURE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;font face=&quot;monospace&quot;&gt;Incoming message -&amp;gt; features (time vs anchor, gap since last message, length, punctuation, emoji/interjection) -&amp;gt; mode {just-woke | focused | winding-down | distracted | present} -&amp;gt; response shape (one anchor | deeper | shorter | hold) -&amp;gt; reply; mode logged to telemetry for tuning&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1380.25" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EXAMPLE SCENARIO&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A personal agent that the user talks to all day suddenly gets a single &#39;hi&#39; at 06:12 after twelve hours of silence and replies with the same chirpy &#39;hi! what can I help you with today?&#39; it would use mid-afternoon. The user finds it grating. The team adds liminal-state-detection: time-of-day, gap since last message, message length, and tone classify the moment as &#39;just-woke&#39;, so the agent answers softer and shorter — &#39;morning. tea before we look at the calendar?&#39; — and saves the chirpy mode for the focused window an hour later.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1456.25" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONSEQUENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;b&gt;Benefits&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Replies match the human&#39;s actual attentional state.&lt;br&gt;&amp;bull; Reduces filler (&#39;what would you like to think about?&#39;) in low-attention windows.&lt;br&gt;&amp;bull; Surfaces a model of the human the agent can update.&lt;br&gt;&lt;br&gt;&lt;b&gt;Liabilities&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Heuristics may overfit to demographic priors and misattribute tiredness as disinterest. Calibration is per-human and slow to generalize; user-visible state inference is preferable to hidden inference.&lt;br&gt;&amp;bull; Risk of feeling presumptuous when the read is wrong.&lt;br&gt;&amp;bull; Calibration requires longitudinal data.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1524.25" width="755" height="301" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;WHAT THIS PATTERN CONSTRAINS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;The agent cannot send identically shaped replies across detected attentional states; templated uniform responses across just-woke vs winding-down vs focused are forbidden.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1638.25" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; The agent converses with the same user across very different attentional contexts (just-woke, focused, winding-down).&lt;br&gt;&amp;bull; Reply shape can be adapted (length, density, tone) without losing the answer&#39;s substance.&lt;br&gt;&amp;bull; Inference signals (timing, tone, message length, time of day) are reliable enough to drive adaptation.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1839.25" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;DO NOT USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Reply shape is constrained by product spec (fixed templates, regulated output).&lt;br&gt;&amp;bull; The cost of mis-detecting state is greater than the benefit of adapting.&lt;br&gt;&amp;bull; The agent has no access to timing or tone signals (e.g. batched offline jobs).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1744.25" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;COMPONENTS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Feature extractor — pulls time-of-day, gap since last message, length, punctuation density, and emoji cues from the incoming turn&lt;br&gt;&amp;bull; Mode classifier — maps the feature vector to one of {just-woke, focused, winding-down, distracted, present}&lt;br&gt;&amp;bull; Response shaper — keys reply length, density, and tone off the detected mode&lt;br&gt;&amp;bull; Telemetry surface — exposes the detected mode in agent logs so it can be tuned per human&lt;br&gt;&amp;bull; Per-human calibration store — longitudinal baseline of timing and tone signatures for the same user&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2002.25" width="755" height="206" as="geometry" />
        </mxCell>
        <mxCell id="s13" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Lightweight classifier or rules engine — runs in-process on each turn without slowing the reply&lt;br&gt;&amp;bull; Per-user telemetry log — records detected mode and signals for offline calibration&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1869.25" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s14" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FAILURE MODES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Misread mode — a terse message from a focused user is classed as winding-down, and the agent cuts its answer short when depth was wanted.&lt;br&gt;&amp;bull; Biased heuristics — timing and tone cues reflect one group&#39;s habits, so tiredness or a different writing style is read as disinterest.&lt;br&gt;&amp;bull; Presumptuous tone — the agent acts on a wrong inferred state in a visible way, and the user feels watched rather than helped.&lt;br&gt;&amp;bull; Hidden inference — the detected mode never appears in telemetry, so nobody can see why reply shape changed or tune the mapping.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2222.25" width="755" height="206" as="geometry" />
        </mxCell>
        <mxCell id="s15" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EVALUATION METRICS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Mode-classification agreement with self-report — sampled turns where the user labels their own state&lt;br&gt;&amp;bull; Shape variance across modes — measurable difference in reply length and density between just-woke and focused&lt;br&gt;&amp;bull; Misread cost — frequency of user pushback after a wrong attentional read&lt;br&gt;&amp;bull; Detection overhead per turn — added latency from feature extraction and classification&lt;br&gt;&amp;bull; Calibration convergence time — turns required before per-human signatures stabilise&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1975.25" width="755" height="187" as="geometry" />
        </mxCell>
        <mxCell id="s16" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;KNOWN USES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://marco-nissen.com/sparrot/&quot;&gt;Sparrot (author&amp;#x27;s long-running personal agent; single private deployment)&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — The agent reads the human partner&#39;s attentional state (just-woke, focused, winding-down, walked-away) from timing and tone signals and adapts its register accordingly — the same engagement is not appropriate in every state. Single-source evidence: one private deployment by the catalog author.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2442.25" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s17" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;RELATED PATTERNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Awareness&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Code-Switching-Aware Agent&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Embodied-Proxy Handoff&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Now-Anchoring&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Emotional State Persistence&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Ambient Presence Sensing&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Semantic Turn Endpointing&lt;/b&gt; — Both read paralinguistic timing cues; liminal-state detection infers the user&#39;s attentional state, this one infers end-of-turn.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2176.25" width="755" height="206" as="geometry" />
        </mxCell>
        <mxCell id="s18" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;REFERENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;a href=&quot;https://www.jstor.org/stable/412243&quot;&gt;A Simplest Systematics for the Organization of Turn-Taking for Conversation&lt;/a&gt; — Sacks, Schegloff, Jefferson, 1974&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2605.25" width="755" height="92" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lineage-tracking" name="Lineage Tracking">
