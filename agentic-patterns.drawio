        <UserObject label="" mermaidId="e:Q2-&gt;LOG#0" mermaidBaseStyle="curved=1;dashed=1;dashPattern=2 3;fixDash=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.31;exitY=1;entryX=0.55;entryY=0;" mermaidBaseValue="" id="m22">
          <mxCell edge="1" parent="1" source="m5" style="curved=1;dashed=1;dashPattern=2 3;fixDash=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.31;exitY=1;entryX=0.55;entryY=0;" target="m10">
