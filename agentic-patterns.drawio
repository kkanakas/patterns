        <UserObject label="Workers queue idle" mermaidId="n:Queue" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=#fee;strokeColor=#c33;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Workers queue idle" id="m5">
          <mxCell parent="1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=#fee;strokeColor=#c33;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="83.7" width="306.9" x="277.35" y="638.6" as="geometry" />
