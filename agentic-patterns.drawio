        <UserObject label="model says &#39;not done&#39;" mermaidId="e:Step-&gt;Step#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=#E8E8E88D;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0;exitY=0.02;entryX=0;entryY=0.98;" mermaidBaseValue="model says &#39;not done&#39;" id="m9">
