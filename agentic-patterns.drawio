        <UserObject label="chain complete" mermaidId="e:Working-&gt;root_end#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=#E8E8E88D;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.75;entryX=1;entryY=0.07;" mermaidBaseValue="chain complete" id="m12">
          <mxCell edge="1" parent="1" source="m1" style="curved=1;startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=#E8E8E88D;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.75;entryX=1;entryY=0.07;" target="m5">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="657.1" y="399.9" />
                <mxPoint x="657.1" y="483.6" />
                <mxPoint x="657.1" y="568.85" />
                <mxPoint x="657.1" y="652.55" />
                <mxPoint x="657.1" y="737.8" />
              </Array>
