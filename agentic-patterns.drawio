          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:O1-&gt;Cr#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="" id="m9">
          <mxCell edge="1" parent="1" source="m2" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="m3">
            <mxGeometry relative="1" as="geometry">
              <Array as="points" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="issues" mermaidId="e:Cr-&gt;Rev#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.23;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="issues" id="m10">
          <mxCell edge="1" parent="1" source="m3" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.23;exitY=1;entryX=0.5;entryY=0;" target="m4">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="173.5" y="776.55" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:Rev-&gt;O2#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.18;entryY=0;" mermaidBaseValue="" id="m11">
          <mxCell edge="1" parent="1" source="m4" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.18;entryY=0;" target="m5">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="173.5" y="951.7" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="loop until clean&#xa;or max iters" mermaidId="e:O2-&gt;Cr#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.82;exitY=0;entryX=0.76;entryY=1;" mermaidBaseValue="loop until clean&#xa;or max iters" id="m12">
          <mxCell edge="1" parent="1" source="m5" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.82;exitY=0;entryX=0.76;entryY=1;" target="m3">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="423.05" y="951.7" />
                <mxPoint x="423.05" y="871.1" />
                <mxPoint x="423.05" y="776.55" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:O2-&gt;Final#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="" id="m13">
          <mxCell edge="1" parent="1" source="m5" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="m6">
            <mxGeometry relative="1" as="geometry">
              <Array as="points" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="s0" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;INTENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Have the model review its own output and produce a revised version in one or more passes.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1280.35" width="755" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONTEXT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A team runs a large language model on a generation task (drafting an email, writing a function, composing a press release) where the first-pass output usually contains errors that a careful second read would catch: a missing edge case, a clumsy phrase, a factual slip. Latency and cost budgets allow at least one extra model call per output. The team is not asking for deep correctness verification, just a &#39;look it over&#39; pass before shipping.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1280.35" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;PROBLEM&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;One-shot generation underuses the model in a specific way: the model has the ability to spot its own surface errors when it is asked to look at a finished draft, but in a single forward pass it commits to tokens without the opportunity to review what it has written. Without a separate critique step, obvious local mistakes ship even when the model could have caught them. A naive free-form critique pass helps a little but invents new criteria on each call, so reviews are inconsistent, and after one or two iterations the same model just starts approving its own work. The team needs structure around the critique step to make it actually catch errors instead of rubber-stamping.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1372.35" width="755" height="187" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FORCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Same-model self-critique misses correlated blind spots.&lt;br&gt;&amp;bull; Free-form review drifts; the model invents new criteria each time.&lt;br&gt;&amp;bull; Termination: when does the loop stop?&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1443.35" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;THEREFORE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Therefore: have the model critique its own draft against named criteria and produce a revision pass, so that obvious local errors are caught before the output leaves the agent.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1573.35" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;SOLUTION&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;After producing an output, the model is prompted (often as a critic persona) to find issues. The original output and critique go back into a revision step. Repeat until a stop condition (no new issues, max iterations).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1568.35" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;STRUCTURE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;font face=&quot;monospace&quot;&gt;Task -&amp;gt; producer pass -&amp;gt; output v1 -&amp;gt; critic pass (fixed criteria) --issues--&amp;gt; revise pass -&amp;gt; output v2 -&amp;gt; critic again ... until no new issues or max iterations -&amp;gt; final output&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1679.35" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EXAMPLE SCENARIO&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A drafting agent writes a press release in one shot; legal flags two compliance issues post-hoc. The team adds a critic pass: after the first draft, the same model is prompted as a compliance reviewer to list concrete issues, then a third pass rewrites against that critique. With one extra round-trip, most legal-flag issues are caught before legal sees the draft. The team caps it at two reflection passes to control cost.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1693.35" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONSEQUENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;b&gt;Benefits&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Catches surface errors cheaply.&lt;br&gt;&amp;bull; Pairs naturally with structured outputs.&lt;br&gt;&lt;br&gt;&lt;b&gt;Liabilities&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Diminishing returns after one or two passes.&lt;br&gt;&amp;bull; Self-reinforced confidence on wrong answers (Reflexion replication studies).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1804.35" width="755" height="225" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;WHAT THIS PATTERN CONSTRAINS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;The reviewer may only critique against criteria fixed by the surrounding system; free-form criteria invention is forbidden when the pattern is used at a correctness boundary.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1856.35" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; One-shot generation underuses the model and a critique pass would catch errors.&lt;br&gt;&amp;bull; A critic prompt can identify issues meaningfully on the task&#39;s outputs.&lt;br&gt;&amp;bull; Stop conditions (no new issues, max iterations) can be defined.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2043.35" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;DO NOT USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; The model already produces correct outputs in one pass.&lt;br&gt;&amp;bull; Latency or cost cannot accommodate extra revision rounds.&lt;br&gt;&amp;bull; Self-critique at this scale is unreliable and just rationalises errors.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1962.35" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;COMPONENTS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Producer — LLM that drafts the initial output&lt;br&gt;&amp;bull; Critic persona — same or different model invoked to list concrete issues&lt;br&gt;&amp;bull; Reviser — pass that rewrites the draft against the critic&#39;s findings&lt;br&gt;&amp;bull; Stop-condition controller — terminates on no-new-issues or max-iteration cap&lt;br&gt;&amp;bull; Named-criteria spec — explicit list the critic must score against to avoid drift&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2168.35" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s13" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; LLM API — at least two calls per pass (critic and revise), optionally a third for the draft&lt;br&gt;&amp;bull; Diff or structured-feedback channel — carries issue list from critic into reviser&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2087.35" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s14" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FAILURE MODES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Self-approval — after a pass or two the same model signs off on its own draft, and remaining errors ship with added confidence.&lt;br&gt;&amp;bull; Wrong answer reinforced — the critique argues for the original mistake, and the revision states it more firmly.&lt;br&gt;&amp;bull; Criteria drift — the critic invents new criteria each call, so the loop rewrites style while a factual error stays.&lt;br&gt;&amp;bull; Pointless extra passes — iterations past the first one or two add cost without finding new issues.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2331.35" width="755" height="187" as="geometry" />
        </mxCell>
        <mxCell id="s15" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EVALUATION METRICS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Surface-defect catch rate — share of obvious errors the critic surfaces on pass 2&lt;br&gt;&amp;bull; Quality lift per iteration — slope of quality vs pass number, identifying the elbow&lt;br&gt;&amp;bull; Self-reinforced confidence rate — share of wrong outputs the critic wrongly endorses&lt;br&gt;&amp;bull; Termination distribution — how often the loop stops on clean vs hits the iteration cap&lt;br&gt;&amp;bull; Cost overhead per shipped output — extra tokens the critic and revise passes add&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2193.35" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s16" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;KNOWN USES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;b&gt;Knitting-DSL Pipeline (Stash2Go)&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — scopedLlmReviewer.js runs a frozen 6-item rubric.&lt;br&gt;&amp;bull; &lt;b&gt;Self-Refine paper&lt;/b&gt; &lt;i&gt;available&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2532.35" width="755" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s17" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;RELATED PATTERNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;i&gt;generalises&lt;/i&gt; &lt;b&gt;Frozen Rubric Reflection&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;specialises&lt;/i&gt; &lt;b&gt;Evaluator-Optimizer&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;generalises&lt;/i&gt; &lt;b&gt;Reflexion&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;used-by&lt;/i&gt; &lt;b&gt;Agentic RAG&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;generalises&lt;/i&gt; &lt;b&gt;Chain of Verification&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;generalises&lt;/i&gt; &lt;b&gt;Self-Refine&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;alternative-to&lt;/i&gt; &lt;b&gt;Same-Model Self-Critique&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;generalises&lt;/i&gt; &lt;b&gt;Tool-Augmented Self-Correction&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;used-by&lt;/i&gt; &lt;b&gt;Self-RAG&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Commitment Tracking&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;generalises&lt;/i&gt; &lt;b&gt;Cross-Reflection&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;generalises&lt;/i&gt; &lt;b&gt;Generator-Critic Separation&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;i&gt;generalises&lt;/i&gt; &lt;b&gt;Human Reflection&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2356.35" width="755" height="301" as="geometry" />
        </mxCell>
        <mxCell id="s18" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;REFERENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;a href=&quot;https://arxiv.org/abs/2303.17651&quot;&gt;Self-Refine: Iterative Refinement with Self-Feedback&lt;/a&gt; — Madaan et al., 2023&lt;br&gt;&amp;bull; &lt;a href=&quot;https://doi.org/10.1016/j.jss.2024.112278&quot;&gt;Agent design pattern catalogue: A collection of architectural patterns for foundation model based agents&lt;/a&gt; — Yue Liu, Sin Kit Lo, Qinghua Lu, Liming Zhu, Dehai Zhao, Xiwei Xu, Stefan Harrer, Jon Whittle, 2025&lt;br&gt;&amp;bull; &lt;a href=&quot;https://archive.org/details/reflectivepracti0000scho&quot;&gt;The Reflective Practitioner: How Professionals Think in Action&lt;/a&gt; — Donald A. Schön, 1983&lt;br&gt;&amp;bull; &lt;a href=&quot;https://doi.org/10.1037/0003-066X.34.10.906&quot;&gt;Metacognition and Cognitive Monitoring: A New Area of Cognitive-Developmental Inquiry&lt;/a&gt; — John H. Flavell, 1979&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2638.35" width="755" height="225" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
