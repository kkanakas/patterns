        </UserObject>
        <UserObject label="" mermaidId="e:M-&gt;A#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="" id="m6">
          <mxCell edge="1" parent="1" source="m1" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="m2">
            <mxGeometry relative="1" as="geometry">
              <Array as="points" />
