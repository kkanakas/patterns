        <UserObject label="" mermaidId="e:S-&gt;C#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.27;exitY=1;entryX=1;entryY=0.09;" mermaidBaseValue="" id="m19">
