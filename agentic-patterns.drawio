              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:Idle-&gt;_note_1#0" mermaidBaseStyle="curved=1;dashed=1;dashed=1;startArrow=none;endArrow=none;fillColor=none;strokeColor=#aaaa33;exitX=0;exitY=0.7;entryX=0.47;entryY=0;" mermaidBaseValue="" id="m5">
