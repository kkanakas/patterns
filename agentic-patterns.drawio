          <mxGeometry x="30" y="95" width="1540" height="789.9" as="geometry" />
        </mxCell>
        <mxCell id="arch-heading" value="&lt;b&gt;ARCHITECTURE&lt;/b&gt; &amp;nbsp; &lt;span style=&quot;color:#52606d&quot;&gt;Editable diagram imported from the pattern source&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="48" y="109" width="1504" height="28" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;AwarenessState&lt;/b&gt;" mermaidId="n:AwarenessState" mermaidBaseStyle="swimlane;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=light-dark(#ECECFF,#1f2020);whiteSpace=wrap;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="&lt;b&gt;AwarenessState&lt;/b&gt;" id="m0">
          <mxCell parent="1" style="swimlane;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=light-dark(#ECECFF,#1f2020);whiteSpace=wrap;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1">
            <mxGeometry height="372.0" width="384.4" x="168.85" y="155.0" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="m1" parent="1" style="text;fontSize=16;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;spacingBottom=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);" value="+tools: ToolDescriptor[]" vertex="1">
          <mxGeometry height="37.2" width="384.4" y="235.6" as="geometry" />
        </mxCell>
