        <UserObject label="" mermaidId="e:Dropped-&gt;root_end#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=1;entryY=0.29;" mermaidBaseValue="" id="m15">
          <mxCell edge="1" parent="1" source="m5" style="curved=1;startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=1;entryY=0.29;" target="m6">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="489.7" y="737.8" />
                <mxPoint x="489.7" y="821.5" />
                <mxPoint x="489.7" y="891.25" />
              </Array>
