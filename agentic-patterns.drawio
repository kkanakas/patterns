          <mxCell edge="1" parent="1" source="m0" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.19;exitY=1;entryX=0.35;entryY=0;" target="m2">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
