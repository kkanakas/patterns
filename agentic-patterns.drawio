        <UserObject label="" mermaidId="e:S-&gt;L#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.64;exitY=1;entryX=0.38;entryY=0;" mermaidBaseValue="" id="m22">
          <mxCell edge="1" parent="1" source="m7" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.64;exitY=1;entryX=0.38;entryY=0;" target="m9">
