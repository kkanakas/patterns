        <UserObject label="" mermaidId="e:Sc1-&gt;Cmp#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.49;exitY=1;entryX=0.11;entryY=0;" mermaidBaseValue="" id="m12">
          <mxCell edge="1" parent="1" source="m3" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.49;exitY=1;entryX=0.11;entryY=0;" target="m5">
            <mxGeometry relative="1" as="geometry">
