        <UserObject label="" mermaidId="e:P-&gt;S#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0;exitY=0.98;entryX=1;entryY=0.96;" mermaidBaseValue="" id="m11">
          <mxCell edge="1" parent="1" source="m5" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0;exitY=0.98;entryX=1;entryY=0.96;" target="m0">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="1296.04" y="228.34" />
                <mxPoint x="1199.64" y="228.34" />
                <mxPoint x="1102.4" y="228.34" />
                <mxPoint x="969.74" y="228.34" />
                <mxPoint x="837.08" y="228.34" />
                <mxPoint x="677.23" y="228.34" />
