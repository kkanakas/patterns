        <UserObject label="" mermaidId="e:S2-&gt;Sup#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.45774647887323944;exitY=0;entryX=0.47818181818181815;entryY=1;curved=1;exitX=0.46;exitY=0;entryX=0.48;entryY=1;" mermaidBaseValue="" id="m11">
