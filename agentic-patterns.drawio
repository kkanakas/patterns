        <UserObject label="" mermaidId="e:Step2-&gt;Model#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.31;entryX=1;entryY=0.94;" mermaidBaseValue="" id="m10">
