        <mxCell id="m4" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);" value="[until cap or task done]" vertex="1">
          <mxGeometry height="24.8" width="737.8" x="148.7" y="158.1" as="geometry" />
        </mxCell>
