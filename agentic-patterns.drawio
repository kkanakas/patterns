        <mxCell id="title" value="&lt;div style=&quot;font-size:24px&quot;&gt;&lt;b&gt;Context Window Packing&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#52606d&quot;&gt;Memory &amp;nbsp; | &amp;nbsp; mature &amp;nbsp; | &amp;nbsp; Also known as: Context Compression, Token Budget Management, Fit in Context, Token Cost Reduction&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1540" height="58" as="geometry" />
        </mxCell>
        <mxCell id="arch-panel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8fc;strokeColor=#b6c6d8;strokeWidth=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="95" width="1540" height="837.95" as="geometry" />
        </mxCell>
        <mxCell id="arch-heading" value="&lt;b&gt;ARCHITECTURE&lt;/b&gt; &amp;nbsp; &lt;span style=&quot;color:#52606d&quot;&gt;Editable diagram imported from the pattern source&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="48" y="109" width="1504" height="28" as="geometry" />
        </mxCell>
        <UserObject label="Token budget T" mermaidId="n:B" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Token budget T" id="m0">
          <mxCell parent="1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="83.7" width="263.5" x="494.35" y="155.0" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Reserve N for system + tools + reply" mermaidId="n:R" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Reserve N for system + tools + reply" id="m1">
          <mxCell parent="1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="83.7" width="491.35" x="379.65" y="316.2" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Packing policy" mermaidId="n:P" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Packing policy" id="m2">
