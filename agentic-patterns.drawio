              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:C-&gt;E#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.03;entryY=0;" mermaidBaseValue="" id="m11">
          <mxCell edge="1" parent="1" source="m2" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.03;entryY=0;" target="m4">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="278.9" y="629.3" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:D-&gt;E#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.97;entryY=0;" mermaidBaseValue="" id="m12">
          <mxCell edge="1" parent="1" source="m3" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.97;entryY=0;" target="m4">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="779.55" y="629.3" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="finish step auto-runs suite" mermaidId="e:E-&gt;F#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="finish step auto-runs suite" id="m13">
          <mxCell edge="1" parent="1" source="m4" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="m5">
            <mxGeometry relative="1" as="geometry">
              <Array as="points" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="values match" mermaidId="e:F-&gt;G#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.13;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="values match" id="m14">
          <mxCell edge="1" parent="1" source="m5" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.13;exitY=1;entryX=0.5;entryY=0;" target="m6">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="365.7" y="1249.3" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="value drifted" mermaidId="e:F-&gt;H#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.87;exitY=1;entryX=0.5;entryY=0;" mermaidBaseValue="value drifted" id="m15">
          <mxCell edge="1" parent="1" source="m5" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);exitX=0.87;exitY=1;entryX=0.5;entryY=0;" target="m7">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="691.2" y="1249.3" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="arch-caption" value="&lt;i&gt;Behaviour is pinned before the edit; the agent&#39;s finish step auto-runs the suite, and any drift in a deterministic value blocks the change.&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#52606d;" vertex="1" parent="1">
          <mxGeometry x="65" y="1393.25" width="1470" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;INTENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Capture the current behaviour of agent-touchable code as golden characterization tests before an agent edits it, with load-bearing values computed deterministically and only prose left to the model, run as a regression gate.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1468.25" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONTEXT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A coding or skill agent is about to refactor or extend a body of legacy code whose existing behaviour encodes business rules that nobody has written down. The rules live in the code itself: a pricing tier boundary, a rounding convention, an aggregation order. The agent reads the code, infers what it can, and rewrites it, but the inferred intent is not the same as the actual behaviour, and a clean refactor can quietly change a hidden invariant that no human notices until production.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1468.25" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;PROBLEM&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Letting an agent edit undocumented code is risky because there is no recorded statement of what the code currently does, so a refactor has nothing to be checked against. Hand-written tests after the fact tend to encode what the model thinks the code should do, not what it did, and a suite written by the same model that wrote the change inherits the model&#39;s blind spots. The team needs a baseline that fixes the existing behaviour exactly, separates the values that must not move from the explanations that may, and fails the moment an edit drifts.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1593.25" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FORCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; The current behaviour is the only available specification, yet it is uncodified and an edit can silently overwrite it.&lt;br&gt;&amp;bull; A numeric result computed by a deterministic function is checkable to the digit, while a model-written explanation of that result is inherently variable.&lt;br&gt;&amp;bull; Tests authored after the edit risk codifying the edit&#39;s behaviour rather than the original; the baseline must be frozen before the agent touches anything.&lt;br&gt;&amp;bull; Pinning every observable detail is brittle and slows the team; pinning too little lets a load-bearing rule slip through unguarded.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1631.25" width="755" height="206" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;THEREFORE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Therefore: before the agent edits, record the existing outputs as golden characterization tests; assert the deterministic core exactly while comparing model-written prose loosely; and run the suite as a mandatory gate on every agent change.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1775.25" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;SOLUTION&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;Run the legacy code against representative inputs and capture its outputs as golden fixtures while the code is still untouched, so the baseline reflects what the code does rather than what anyone believes it should do. Partition each captured output: the load-bearing values, such as totals, tier boundaries, and rounding, are produced by deterministic components and asserted for exact equality, while any model-written narration that explains or annotates the result is compared loosely or excluded from the gate. Wire the suite into the agent&#39;s loop so that finishing an edit triggers the characterization tests automatically, detected from policy keywords rather than left to the agent&#39;s discretion, and treat any exact-match failure as a blocked change. Once the refactor is proven behaviour-preserving, the golden values may be updated deliberately by a human when a rule is meant to change.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="1851.25" width="755" height="225" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;STRUCTURE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;font face=&quot;monospace&quot;&gt;Untouched legacy code --run on representative inputs--&amp;gt; Golden fixtures (deterministic core pinned exactly + prose compared loosely) --gate--&amp;gt; Agent edit --auto-run on finish--&amp;gt; exact-match diff blocks the change&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1900.25" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EXAMPLE SCENARIO&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;A team asks a coding agent to refactor a tangled invoice module that nobody fully understands. Before the agent starts, they run the module on a hundred saved invoices and freeze the resulting totals and tax figures as golden tests. The agent rewrites the module; on finish, the tests run automatically. One invoice now totals a cent less because the agent reordered a rounding step, so the gate fails and the change is rejected before it ever reaches production.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2090.25" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;CONSEQUENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&lt;b&gt;Benefits&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; A silent change to an undocumented business rule shows up as a failing exact-match assertion instead of a production incident.&lt;br&gt;&amp;bull; Separating the deterministic core from model-written prose keeps the gate stable: it fails on a wrong number, not on reworded narration.&lt;br&gt;&amp;bull; The pinned suite doubles as the missing specification, recording what the legacy code actually did at the moment of the edit.&lt;br&gt;&lt;br&gt;&lt;b&gt;Liabilities&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Characterization tests freeze current behaviour including its bugs, so a genuine fix trips the gate and the golden values must be updated by hand.&lt;br&gt;&amp;bull; Capturing fixtures for code with external dependencies or non-determinism needs seams and stubs before the behaviour can be pinned.&lt;br&gt;&amp;bull; Over-pinning incidental output makes the suite brittle and noisy, eroding trust in the gate.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2044.25" width="755" height="358" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;WHAT THIS PATTERN CONSTRAINS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;An agent edit cannot be accepted until the pre-edit characterization suite passes; the deterministic load-bearing values must match the pinned baseline exactly, and changing a golden value requires a deliberate human update rather than a model rewrite.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2253.25" width="755" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; An agent is about to edit legacy code whose behaviour is undocumented but encodes real business rules.&lt;br&gt;&amp;bull; Outputs contain load-bearing numeric or structured values that a deterministic component can compute and assert exactly.&lt;br&gt;&amp;bull; The change is meant to preserve behaviour (a refactor or extension), so the existing outputs are the correct baseline.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2416.25" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;DO NOT USE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; The task is greenfield code with no existing behaviour to capture.&lt;br&gt;&amp;bull; The change is deliberately meant to alter the rules, so freezing the current outputs would only fight the intended change.&lt;br&gt;&amp;bull; Outputs are inherently non-deterministic and cannot be made repeatable even with seams or stubs, leaving nothing to pin exactly.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2378.25" width="755" height="149" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;COMPONENTS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Fixture capturer — runs the untouched legacy code on representative inputs and records its outputs as golden fixtures&lt;br&gt;&amp;bull; Deterministic core — the functions that compute load-bearing values (totals, boundaries, rounding) which are asserted for exact equality&lt;br&gt;&amp;bull; Prose comparator — compares model-written narration loosely or excludes it from the gate so wording changes do not fail the suite&lt;br&gt;&amp;bull; Regression gate — the mandatory check that runs the characterization suite on every agent edit and blocks on any exact-match failure&lt;br&gt;&amp;bull; Finish-step trigger — policy-keyword detection on the agent&#39;s completion step that forces the suite to run rather than leaving it to the agent&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2598.25" width="755" height="244" as="geometry" />
        </mxCell>
        <mxCell id="s13" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Test runner (for example Jest or pytest) — executes the characterization suite and reports exact-match diffs&lt;br&gt;&amp;bull; Snapshot/golden-fixture store — holds the pinned outputs captured before the edit&lt;br&gt;&amp;bull; Agent harness keyword hook — detects the completion step and forces the regression gate to run&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2541.25" width="755" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s14" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;FAILURE MODES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Pinning after the edit — the baseline records the changed behaviour, so the gate can never catch the drift it was meant to catch.&lt;br&gt;&amp;bull; Asserting prose exactly — a reworded model explanation fails the gate even though every load-bearing value is unchanged.&lt;br&gt;&amp;bull; Sparse coverage — the captured inputs miss the branch that holds the hidden rule, so the rule changes without any test noticing.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="2856.25" width="755" height="168" as="geometry" />
        </mxCell>
        <mxCell id="s15" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;EVALUATION METRICS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; Silent-behaviour-change catch rate — fraction of value-altering edits caught by the gate before merge&lt;br&gt;&amp;bull; False-fail rate from prose — gate failures caused by reworded narration rather than a changed value, which should trend to zero&lt;br&gt;&amp;bull; Pinned-branch coverage — share of behaviour-bearing branches exercised by the captured fixtures&lt;br&gt;&amp;bull; Baseline-update frequency — how often golden values are deliberately changed by a human, signalling intended rule changes versus accidental drift&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2685.25" width="755" height="187" as="geometry" />
        </mxCell>
        <mxCell id="s16" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;KNOWN USES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://techblog.gccompany.co.kr/ai-%EC%BD%94%EB%94%A9-%EC%97%90%EC%9D%B4%EC%A0%84%ED%8A%B8%EC%97%90%EA%B2%8C-%EC%82%AC%EA%B3%A0-%EA%B3%BC%EC%A0%95%EC%9D%84-%EC%84%A4%EA%B3%84%ED%95%98%EB%8B%A4-9c7325e4655d&quot;&gt;Yeogi Eottae (GC Company) AI coding-agent harness&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Engineering blog describes capturing existing behaviour as Jest tests before the agent edits, then auto-detecting policy keywords on a /done step to force the tests to run as a gate.&lt;br&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://cloudbro.ai&quot;&gt;CloudBro AI-assisted refactoring guidance&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Korean practitioner write-up advocating pinning legacy behaviour with characterization tests before letting an assistant refactor.&lt;br&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://approvaltests.com/&quot;&gt;ApprovalTests&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Golden-master/characterization-test library family (Java, .NET, C++, Python, JS) that approves the current output as a baseline and fails when subsequent runs diverge, the canonical pin-before-edit mechanism for legacy code.&lt;br&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://jestjs.io/docs/snapshot-testing&quot;&gt;Jest snapshot testing&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Captures a reference snapshot of output and fails on any later run whose output does not match, the snapshot form of pinning existing behaviour before a change.&lt;br&gt;&amp;bull; &lt;b&gt;&lt;a href=&quot;https://github.com/trytouca/trytouca&quot;&gt;Touca&lt;/a&gt;&lt;/b&gt; &lt;i&gt;available&lt;/i&gt; — Continuous regression testing that captures values and runtimes of a workflow and remotely compares them against a trusted baseline version, flagging unintended behaviour drift from code changes.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="3038.25" width="755" height="377" as="geometry" />
        </mxCell>
        <mxCell id="s17" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;RELATED PATTERNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Silent Hypotheses in Generated Code&lt;/b&gt; — That anti-pattern is the disease — a hidden premise ships unguarded; pinning the existing behaviour as exact golden tests before the edit is the cure side, catching the silent mutation at the gate.&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Eval as Contract&lt;/b&gt; — Eval-as-contract treats the suite as the release gate going forward; this pattern seeds that contract with a behaviour-preserving baseline frozen before the agent touches the code.&lt;br&gt;&amp;bull; &lt;i&gt;alternative-to&lt;/i&gt; &lt;b&gt;Eval Harness&lt;/b&gt; — An eval harness scores held-out quality against expected outputs to track improvement; this pattern instead freezes the code&#39;s own current outputs as the must-match baseline before an edit, with no notion of better, only unchanged.&lt;br&gt;&amp;bull; &lt;i&gt;complements&lt;/i&gt; &lt;b&gt;Deterministic-LLM Sandwich&lt;/b&gt; — The sandwich brackets each runtime call with deterministic checks; here the same deterministic-versus-model partition is applied at authoring time so pinned values are exact and model prose is compared loosely.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2886.25" width="755" height="282" as="geometry" />
        </mxCell>
        <mxCell id="s18" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;REFERENCES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35&quot;&gt;&amp;bull; &lt;a href=&quot;https://www.oreilly.com/library/view/working-effectively-with/0131177052/&quot;&gt;Working Effectively with Legacy Code&lt;/a&gt; — Michael C. Feathers, 2004&lt;br&gt;&amp;bull; &lt;a href=&quot;https://michaelfeathers.silvrback.com/characterization-testing&quot;&gt;Characterization Tests&lt;/a&gt; — Michael C. Feathers, 2011&lt;br&gt;&amp;bull; &lt;a href=&quot;https://arxiv.org/abs/2603.23443&quot;&gt;Evaluating LLM-Based Test Generation Under Software Evolution&lt;/a&gt; — Sabaat Haroon, Mohammad Taha Khan, Muhammad Ali Gulzar, 2026&lt;br&gt;&amp;bull; &lt;a href=&quot;https://arxiv.org/abs/2511.04824&quot;&gt;Agentic Refactoring: An Empirical Study of AI Coding Agents&lt;/a&gt; — Kosei Horikawa, Hao Li, Yutaro Kashiwa, Bram Adams, Hajimu Iida, Ahmed E. Hassan, 2025&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0db;spacing=11;align=left;verticalAlign=top;" vertex="1" parent="1">
