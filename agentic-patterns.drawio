        <UserObject label="" mermaidId="e:M-&gt;R#0" mermaidBaseStyle="curved=1;startArrow=block;startSize=7;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.5895522388059702;entryX=0;entryY=0.5821917808219178;curved=1;exitX=1;exitY=0.59;entryX=0;entryY=0.58;" mermaidBaseValue="" id="m6">
