        <mxCell id="title" value="&lt;div style=&quot;font-size:24px&quot;&gt;&lt;b&gt;Standing State Injection&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#52606d&quot;&gt;Planning &amp;amp; Control Flow &amp;nbsp; | &amp;nbsp; emerging &amp;nbsp; | &amp;nbsp; Also known as: Current-State Recitation, Per-Turn State Snapshot, Standing Goal Block&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
