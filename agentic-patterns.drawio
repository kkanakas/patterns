        <UserObject label="" mermaidId="e:S-&gt;Step#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.74;exitY=0;entryX=1;entryY=0.59;" mermaidBaseValue="" id="m22">
          <mxCell edge="1" parent="1" source="m7" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=0.74;exitY=0;entryX=1;entryY=0.59;" target="m0">
            <mxGeometry relative="1" as="geometry">
