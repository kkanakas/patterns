        <UserObject label="" mermaidId="e:M-&gt;T#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.24;entryX=1;entryY=0.74;" mermaidBaseValue="" id="m20">
          <mxCell edge="1" parent="1" source="m8" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.24;entryX=1;entryY=0.74;" target="m0">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="1579.7" y="1024.74" />
                <mxPoint x="1579.7" y="958.33" />
