        <UserObject label="" mermaidId="e:P-&gt;L#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.91;entryX=0.51;entryY=0;" mermaidBaseValue="" id="m21">
          <mxCell edge="1" parent="1" source="m4" style="curved=1;startArrow=none;endArrow=block;endSize=7;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.91;entryX=0.51;entryY=0;" target="m9">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="1181.88" y="439.68" />
                <mxPoint x="1181.88" y="628.14" />
                <mxPoint x="1181.88" y="825.53" />
                <mxPoint x="1181.88" y="887.02" />
                <mxPoint x="1181.88" y="938.6" />
